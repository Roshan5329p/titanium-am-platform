      cascade_id: "3b7f8d86-d2e1-4131-8a5a-5c9c183a652d"
    }
    step_generation_version: 1
    last_completed_chunk_at {
      seconds: 1793254624
      nanos: 555707169
    }
    tool_call_output_tokens: 12246
    model_info {
      model_name: "gemini-4-argon"
      thinking_level: 2
