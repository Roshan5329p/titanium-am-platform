      create_file {
        instruction: "import React from \'react\';\n\ninterface FinalCTASectionProps {\n  onStartFree: () => void;\n  onContactSales: () => void;\n}\n\nexport function FinalCTASection({ onStartFree, onContactSales }: FinalCTASectionProps) {\n  return (\n    <section className=\"px-4 sm:px-8 border-t border-[#232426] flex flex-col justify-center items-center text-center py-24 sm:py-32 max-w-[1728px] mx-auto\">\n      <div className=\"max-w-3xl\">\n        <h2 className=\"font-h1 text-4xl sm:text-6xl lg:text-[76px] text-[#e5e2e3] mb-8 sm:mb-10 tracking-tight leading-[1.08]\">\n          Built for clarity.<br />Ready today.\n        </h2>\n        <div className=\"flex flex-wrap justify-center gap-4\">\n          <button\n            onClick={onStartFree}\n            className=\"bg-white text-black px-8 py-3.5 rounded font-body-lg font-bold hover:bg-[#e0e0e0] transition-colors shadow-lg active:scale-[0.98]\"\n          >\n            Start free trial\n          </button>\n          <button\n            onClick={onContactSales}\n            className=\"bg-transparent border border-[#232426] text-[#e5e2e3] px-8 py-3.5 rounded font-body-lg hover:bg-[#1a1b1d] hover:border-white/20 transition-colors active:scale-[0.98]\"\n          >\n            Contact sales\n          </button>\n        </div>\n        <p className=\"text-xs font-mono-data text-[#9A9DA3]/60 mt-6 tracking-wider uppercase\">\n          14-DAY FULL ACCESS // NO CREDIT CARD REQUIRED // SOC 2 TYPE II READY\n        </p>\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/FinalCTASection.tsx"
        }
        overwrite: true
      }
    }
