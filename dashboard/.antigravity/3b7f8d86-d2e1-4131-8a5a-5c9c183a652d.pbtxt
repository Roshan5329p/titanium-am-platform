  code_action {
    action_spec {
      create_file {
        instruction: "export type MaterialCategory =\n  | \'All Materials\'\n  | \'Metals & Alloys\'\n  | \'Polymers\'\n  | \'Ceramics & Glasses\'\n  | \'Semiconductors\'\n  | \'Carbon Materials\'\n  | \'Composites\'\n  | \'Natural / Wood\';\n\nexport interface ProcessStep {\n  phaseCode: string;\n  stage: string;\n  temperature: string;\n  pressure: string;\n  duration: string;\n  atmosphere: string;\n  details: string;\n}\n\nexport interface ProcessVariant {\n  id: string;\n  name: string;\n  shortName: string;\n  temperOrGrade: string;\n  summary: string;\n  peakTempC: number;\n  holdTimeMin: number;\n  coolingRate: string;\n  atmosphere: string;\n  yieldChangePct: string;\n  steps: ProcessStep[];\n  propertyOverrides?: {\n    tensileStrengthMPa?: string;\n    yieldStrengthMPa?: string;\n    elongationPct?: string;\n    hardness?: string;\n    thermalConductivity?: string;\n    electricalResistivity?: string;\n  };\n}\n\nexport interface MaterialItem {\n  id: string;\n  name: string;\n  category: Exclude<MaterialCategory, \'All Materials\'>;\n  tagLabel: string; // e.g., \'Metal\', \'Polymer\', \'Ceramic\', \'Semiconductor\', \'Carbon\', \'Composite\', \'Natural\'\n  subtitle: string; // e.g., \'Aluminum alloy\'\n  formula: string;\n  crystalStructure: string;\n  standardCode: string;\n  overview: string;\n  applications: string[];\n  mechanical: {\n    tensileStrengthMPa: string;\n    yieldStrengthMPa: string;\n    elasticModulusGPa: string;\n    elongationPct: string;\n    hardness: string;\n    fractureToughness: string;\n  };\n  thermal: {\n    meltingOrTgC: string;\n    thermalConductivity: string;\n    thermalExpansionCTE: string;\n    specificHeat: string;\n    maxServiceTempC: string;\n  };\n  electricalAndPhysical: {\n    densityGcm3: string;\n    electricalResistivity: string;\n    conductivityOrDielectric: string;\n    magneticOrOptical: string;\n  };\n  processRoutes: ProcessVariant[];\n}\n\n// Helper to generate comprehensive process variants for standard materials while keeping flagship ones ultra-custom\nfunction buildWroughtMetalRoutes(\n  matName: string,\n  meltTemp: number,\n  hotWorkTemp: number,\n  annealTemp: number,\n  extraCount: 5 | 6,\n  baseUTS: number,\n  baseYield: number\n): ProcessVariant[] {\n  const routes: ProcessVariant[] = [\n    {\n      id: \'hot-roll-extrude-forge\',\n      name: \'Hot rolling / extrusion / forging\',\n      shortName: \'Hot rolling / extrusion / forging\',\n      temperOrGrade: \'T6 / Thermomechanical Wrought\',\n      summary: `Primary ingot homogenization followed by hot deformation above recrystallization threshold (${hotWorkTemp} \302\260C), solution treatment, water quench, and precipitation aging.`,\n      peakTempC: hotWorkTemp,\n      holdTimeMin: 180,\n      coolingRate: \'250 \302\260C/s (Polymer-Water Quench)\',\n      atmosphere: \'Argon / Ambient Air\',\n      yieldChangePct: \'+18.4%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // CAST_HOMOGENIZE\',\n          stage: \'DC Casting & Ingot Homogenization\',\n          temperature: `${Math.round(meltTemp * 0.82)} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'6.0 hr\',\n          atmosphere: \'Inert Argon Shield\',\n          details: `Dissolves interdendritic eutectic phases and equalizes solute distribution across ${matName} billet.`,\n        },\n        {\n          phaseCode: \'PHASE_02 // HOT_DEFORMATION\',\n          stage: \'Multi-Pass Hot Rolling / Extrusion\',\n          temperature: `${hotWorkTemp} \302\260C`,\n          pressure: \'140 \342\200\223 280 MPa\',\n          duration: \'45 min\',\n          atmosphere: \'Ambient\',\n          details: \'Dynamic recovery refines coarse cast grains into aligned wrought fibrous microstructure.\',\n        },\n        {\n          phaseCode: \'PHASE_03 // SOLUTION_QUENCH\',\n          stage: \'Solution Heat Treatment & Rapid Quench\',\n          temperature: `${annealTemp + 115} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'90 min\',\n          atmosphere: \'Forced Convection Furnace\',\n          details: \'Forms supersaturated solid solution (SSSS) prior to controlled precipitation hardening.\',\n        },\n        {\n          phaseCode: \'PHASE_04 // ARTIFICIAL_AGE\',\n          stage: \'Precipitation Aging Stabilization\',\n          temperature: \'175 \302\260C\',\n          pressure: \'0.1 MPa\',\n          duration: \'8.0 hr\',\n          atmosphere: \'Nitrogen\',\n          details: \'Nucleates coherent nanoscale precipitates for peak yield and tensile strength.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${baseUTS} MPa`,\n        yieldStrengthMPa: `${baseYield} MPa`,\n        elongationPct: \'12.5 %\',\n      },\n    },\n    {\n      id: \'hot-roll-cold-roll\',\n      name: \'Hot rolling + cold rolling\',\n      shortName: \'Hot rolling + cold rolling\',\n      temperOrGrade: \'H14 / Strain-Hardened Sheet\',\n      summary: `Hot breakdown rolling followed by room-temperature cold reduction (35\342\200\22360% thickness reduction) to increase dislocation density and surface finish precision.`,\n      peakTempC: Math.round(hotWorkTemp * 0.9),\n      holdTimeMin: 120,\n      coolingRate: \'45 \302\260C/min (Forced Air)\',\n      atmosphere: \'Emulsion Lubricated Roll Gap\',\n      yieldChangePct: \'+24.0%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // HOT_BREAKDOWN\',\n          stage: \'Slab Reheating & Breakdown Mill\',\n          temperature: `${Math.round(hotWorkTemp * 0.92)} \302\260C`,\n          pressure: \'180 MPa\',\n          duration: \'60 min\',\n          atmosphere: \'Oxidizing / Mill Scale Control\',\n          details: \'Reduces cast slab thickness from 400 mm to 6 mm coil stock.\',\n        },\n        {\n          phaseCode: \'PHASE_02 // COLD_TANDEM\',\n          stage: \'Cold Tandem Rolling (50% Reduction)\',\n          temperature: \'25 \342\200\223 65 \302\260C\',\n          pressure: \'420 MPa\',\n          duration: \'20 min\',\n          atmosphere: \'Kerosene / Ester Mist\',\n          details: \'Work-hardens matrix via dislocation entanglement; achieves Ra < 0.2 \302\265m finish.\',\n        },\n        {\n          phaseCode: \'PHASE_03 // RECOVERY_ANNEAL\',\n          stage: \'Partial Recovery Anneal\',\n          temperature: `${annealTemp - 60} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'2.0 hr\',\n          atmosphere: \'Dry Nitrogen\',\n          details: \'Relieves peak residual stresses while retaining strain-hardened yield margin.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${Math.round(baseUTS * 1.08)} MPa`,\n        yieldStrengthMPa: `${Math.round(baseYield * 1.14)} MPa`,\n        elongationPct: \'7.2 %\',\n      },\n    },\n    {\n      id: \'forging\',\n      name: \'Forging\',\n      shortName: \'Forging\',\n      temperOrGrade: \'Closed-Die Isothermal Forged\',\n      summary: `Triaxial compressive closed-die forging aligning grain flow lines with principal component stress contours for maximum fatigue resistance.`,\n      peakTempC: hotWorkTemp - 15,\n      holdTimeMin: 95,\n      coolingRate: \'120 \302\260C/s (Oil / Polymer Quench)\',\n      atmosphere: \'Graphite Die Lubricated\',\n      yieldChangePct: \'+15.2%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // BILLET_PREHEAT\',\n          stage: \'Induction Billet Preheating\',\n          temperature: `${hotWorkTemp - 15} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'40 min\',\n          atmosphere: \'Controlled Induction\',\n          details: \'Uniform thermal soak with < \302\2613 \302\260C core-to-surface gradient.\',\n        },\n        {\n          phaseCode: \'PHASE_02 // CLOSED_DIE_PRESS\',\n          stage: \'Hydraulic Closed-Die Forging (3500 Ton)\',\n          temperature: `${hotWorkTemp - 25} \302\260C`,\n          pressure: \'550 MPa\',\n          duration: \'12 min\',\n          atmosphere: \'Die Cavity\',\n          details: \'Eliminates internal microporosity and aligns grain flow parallel to part geometry.\',\n        },\n        {\n          phaseCode: \'PHASE_03 // T6_TEMPERING\',\n          stage: \'Post-Forge Solution & Aging\',\n          temperature: \'180 \302\260C\',\n          pressure: \'0.1 MPa\',\n          duration: \'6.5 hr\',\n          atmosphere: \'Air Recirculation\',\n          details: \'Stabilizes mechanical anisotropy and fracture toughness.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${Math.round(baseUTS * 1.04)} MPa`,\n        yieldStrengthMPa: `${Math.round(baseYield * 1.06)} MPa`,\n        elongationPct: \'14.0 %\',\n      },\n    },\n    {\n      id: \'annealed-o\',\n      name: \'Full Recrystallization Annealing (O-Temper)\',\n      shortName: \'Annealing (O-Temper)\',\n      temperOrGrade: \'O / Fully Softened Ductile\',\n      summary: `Controlled thermal soak above recrystallization temperature followed by slow furnace cooling to maximize formability and deep-drawing ductility.`,\n      peakTempC: annealTemp,\n      holdTimeMin: 150,\n      coolingRate: \'15 \302\260C/hr (Furnace Cool)\',\n      atmosphere: \'Inert Nitrogen / H2 Mix\',\n      yieldChangePct: \'-42.0%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // RAMP_HEAT\',\n          stage: \'Controlled Furnace Ramp\',\n          temperature: `${annealTemp} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'2.5 hr\',\n          atmosphere: \'95% N2 / 5% H2\',\n          details: \'Nucleates strain-free equiaxed grains across deformed matrix.\',\n        },\n        {\n          phaseCode: \'PHASE_02 // FURNACE_COOL\',\n          stage: \'Equilibrium Slow Cool\',\n          temperature: \'260 \302\260C -> 25 \302\260C\',\n          pressure: \'0.1 MPa\',\n          duration: \'6.0 hr\',\n          atmosphere: \'Inert\',\n          details: \'Coarsens precipitates to non-hardening equilibrium phases for maximum elongation.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${Math.round(baseUTS * 0.52)} MPa`,\n        yieldStrengthMPa: `${Math.round(baseYield * 0.42)} MPa`,\n        elongationPct: \'26.0 %\',\n      },\n    },\n    {\n      id: \'lpbf-additive\',\n      name: \'Laser Powder Bed Fusion (LPBF / 3D Printing)\',\n      shortName: \'LPBF 3D Printing\',\n      temperOrGrade: \'As-Built + Stress Relieved\',\n      summary: `Selective laser melting of gas-atomized spherical powder (15\342\200\22345 \302\265m) under ultra-rapid solidification rates (10^6 K/s), producing ultra-fine cellular dendrites.`,\n      peakTempC: meltTemp + 250,\n      holdTimeMin: 45,\n      coolingRate: \'1.0 \303\227 10^6 K/s (Melt Pool)\',\n      atmosphere: \'High-Purity Argon (< 100 ppm O2)\',\n      yieldChangePct: \'+9.5%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // GAS_ATOMIZATION\',\n          stage: \'Spherical Powder Feedstock Conditioning\',\n          temperature: \'80 \302\260C (Vacuum Dry)\',\n          pressure: \'0.001 MPa\',\n          duration: \'4.0 hr\',\n          atmosphere: \'Vacuum\',\n          details: \'Removes adsorbed moisture to prevent hydrogen keyhole porosity during laser scanning.\',\n        },\n        {\n          phaseCode: \'PHASE_02 // LASER_SCAN\',\n          stage: \'400W Yb-Fiber Laser Scanning (30 \302\265m Layer)\',\n          temperature: `${meltTemp + 250} \302\260C`,\n          pressure: \'0.105 MPa\',\n          duration: \'Build Dependent\',\n          atmosphere: \'Laminar Argon Flow\',\n          details: \'Scan speed 1200 mm/s, hatch spacing 0.10 mm, 67\302\260 layer rotation strategy.\',\n        },\n        {\n          phaseCode: \'PHASE_03 // STRESS_RELIEF\',\n          stage: \'Vacuum Stress Relief & HIP\',\n          temperature: \'300 \302\260C\',\n          pressure: \'100 MPa (Ar HIP)\',\n          duration: \'2.0 hr\',\n          atmosphere: \'Argon\',\n          details: \'Closes residual lack-of-fusion pores to achieve 99.92% theoretical density.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${Math.round(baseUTS * 1.05)} MPa`,\n        yieldStrengthMPa: `${Math.round(baseYield * 1.08)} MPa`,\n        elongationPct: \'9.8 %\',\n      },\n    },\n  ];\n\n  if (extraCount === 6) {\n    routes.push({\n      id: \'friction-stir\',\n      name: \'Friction Stir Processing & Extrusion (FSP)\',\n      shortName: \'Friction Stir Processing\',\n      temperOrGrade: \'UFG / Ultra-Fine Grained\',\n      summary: `Severe plastic deformation via rotating non-consumable tool below solidus temperature, generating dynamically recrystallized 1.5 \302\265m equiaxed grains.`,\n      peakTempC: Math.round(hotWorkTemp * 0.85),\n      holdTimeMin: 30,\n      coolingRate: \'80 \302\260C/s (Conduction to Backing Plate)\',\n      atmosphere: \'Solid-State Ambient\',\n      yieldChangePct: \'+21.0%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // TOOL_PLUNGE\',\n          stage: \'Frictional Heating & Pin Plunge\',\n          temperature: `${Math.round(hotWorkTemp * 0.85)} \302\260C`,\n          pressure: \'310 MPa Axial\',\n          duration: \'15 min\',\n          atmosphere: \'Solid State (No Melt)\',\n          details: \'1200 RPM tool rotation plasticizes alloy without liquid-phase solidification defects.\',\n        },\n        {\n          phaseCode: \'PHASE_02 // DYNAMIC_RECRYST\',\n          stage: \'Stir Zone Grain Refinement\',\n          temperature: \'420 \302\260C\',\n          pressure: \'240 MPa\',\n          duration: \'15 min\',\n          atmosphere: \'Ambient\',\n          details: \'Produces Hall-Petch strengthened ultra-fine microstructure with superplastic capability.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: `${Math.round(baseUTS * 1.12)} MPa`,\n        yieldStrengthMPa: `${Math.round(baseYield * 1.16)} MPa`,\n        elongationPct: \'16.5 %\',\n      },\n    });\n  }\n\n  return routes;\n}\n\n// Generic multi-route builder for remaining catalog items to guarantee 100% rich step-by-step data\nfunction buildCategoryRoutes(\n  matName: string,\n  category: Exclude<MaterialCategory, \'All Materials\'>,\n  routeNames: string[],\n  peakTempC: number,\n  baseUTS: string,\n  baseYield: string\n): ProcessVariant[] {\n  return routeNames.map((rName, idx) => {\n    const tempMod = peakTempC + (idx - 1) * 45;\n    return {\n      id: `route-${idx + 1}`,\n      name: rName,\n      shortName: rName,\n      temperOrGrade: `Variant V${idx + 1} // Process-Optimized`,\n      summary: `${rName} synthesis protocol for ${matName}, calibrated for structural homogeneity, low defect density, and repeatable physical properties.`,\n      peakTempC: Math.max(25, tempMod),\n      holdTimeMin: 60 + idx * 35,\n      coolingRate: idx === 0 ? \'15 \302\260C/min (Controlled)\' : idx === 1 ? \'180 \302\260C/s (Rapid Quench)\' : \'5 \302\260C/min (Equilibrium)\',\n      atmosphere: category === \'Semiconductors\' || category === \'Carbon Materials\' ? \'Ultra-High Vacuum / Ar-H2\' : \'Controlled N2 / Inert\',\n      yieldChangePct: idx === 0 ? \'Baseline\' : idx === 1 ? \'+14.2%\' : \'+6.8%\',\n      steps: [\n        {\n          phaseCode: \'PHASE_01 // PRECURSOR_PREP\',\n          stage: \'Feedstock Purification & Stoichiometric Metering\',\n          temperature: `${Math.max(25, Math.round(tempMod * 0.25))} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'45 min\',\n          atmosphere: \'Dry Nitrogen (< 5 ppm H2O)\',\n          details: `Prepares high-purity ${matName} precursors prior to primary ${rName.toLowerCase()} stage.`,\n        },\n        {\n          phaseCode: \'PHASE_02 // PRIMARY_SYNTHESIS\',\n          stage: `Primary ${rName} Reaction / Consolidation`,\n          temperature: `${Math.max(25, tempMod)} \302\260C`,\n          pressure: idx === 1 ? \'85 MPa\' : \'12 MPa\',\n          duration: `${60 + idx * 35} min`,\n          atmosphere: category === \'Semiconductors\' ? \'10^-6 Torr Vacuum\' : \'Inert Argon Shield\',\n          details: `Executes core ${rName} thermal-mechanical profile to achieve target phase density and bonding.`,\n        },\n        {\n          phaseCode: \'PHASE_03 // CONDITIONING\',\n          stage: \'Thermal Stabilization & Surface Metrology\',\n          temperature: `${Math.max(25, Math.round(tempMod * 0.45))} \302\260C`,\n          pressure: \'0.1 MPa\',\n          duration: \'90 min\',\n          atmosphere: \'Controlled Cooling Chamber\',\n          details: \'Eliminates thermal gradient stresses and verifies dimensional and microstructural tolerances.\',\n        },\n      ],\n      propertyOverrides: {\n        tensileStrengthMPa: baseUTS,\n        yieldStrengthMPa: baseYield,\n      },\n    };\n  });\n}\n\n// 1. Flagship First 5 Materials (Exact match to screenshot left pane order!)\nconst flagshipMaterials: MaterialItem[] = [\n  {\n    id: \'al-1100\',\n    name: \'Aluminum 1100\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Aluminum alloy\',\n    formula: \'Al (\342\211\24599.0% Commercially Pure)\',\n    crystalStructure: \'FCC (Face-Centered Cubic, a = 0.4049 nm)\',\n    standardCode: \'UNS A91100 / ISO Al99.0Cu\',\n    overview: \'Commercially pure wrought aluminum alloy with exceptional corrosion resistance, high thermal and electrical conductivity, and superb workability for chemical equipment, heat exchangers, and fin stock.\',\n    applications: [\'Cryogenic heat exchangers\', \'Chemical storage vessels\', \'HVAC fin stock\', \'Busbar electrical conductors\'],\n    mechanical: {\n      tensileStrengthMPa: \'110 MPa\',\n      yieldStrengthMPa: \'105 MPa\',\n      elasticModulusGPa: \'69.0 GPa\',\n      elongationPct: \'12.0 %\',\n      hardness: \'28 HB (Brinell)\',\n      fractureToughness: \'35.0 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'643 \342\200\223 657 \302\260C\',\n      thermalConductivity: \'222 W/m\302\267K\',\n      thermalExpansionCTE: \'23.6 \302\265m/m\302\267K\',\n      specificHeat: \'904 J/kg\302\267K\',\n      maxServiceTempC: \'200 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'2.71 g/cm\302\263\',\n      electricalResistivity: \'2.92 \303\227 10\342\201\273\342\201\270 \316\251\302\267m\',\n      conductivityOrDielectric: \'59.0 % IACS\',\n      magneticOrOptical: \'Paramagnetic / Reflectivity 86%\',\n    },\n    processRoutes: buildWroughtMetalRoutes(\'Aluminum 1100\', 655, 420, 345, 5, 110, 105),\n  },\n  {\n    id: \'al-6061\',\n    name: \'Aluminum 6061\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Aluminum alloy\',\n    formula: \'Al-1.0Mg-0.6Si-0.28Cu-0.2Cr\',\n    crystalStructure: \'FCC Matrix + \316\262\342\200\263 (Mg\342\202\205Si\342\202\206) Precipitates\',\n    standardCode: \'UNS A96061 / AMS 4027\',\n    overview: \'Precipitation-hardenable Al-Mg-Si structural alloy offering an industry-benchmark balance of medium-to-high strength, weldability, marine corrosion resistance, and extrudability.\',\n    applications: [\'Aerospace fuselage frames\', \'Semiconductor vacuum chambers\', \'EV battery enclosures\', \'Precision CNC robotics\'],\n    mechanical: {\n      tensileStrengthMPa: \'310 MPa\',\n      yieldStrengthMPa: \'276 MPa\',\n      elasticModulusGPa: \'68.9 GPa\',\n      elongationPct: \'12.5 %\',\n      hardness: \'95 HB (Brinell)\',\n      fractureToughness: \'29.0 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'582 \342\200\223 652 \302\260C\',\n      thermalConductivity: \'167 W/m\302\267K\',\n      thermalExpansionCTE: \'23.1 \302\265m/m\302\267K\',\n      specificHeat: \'896 J/kg\302\267K\',\n      maxServiceTempC: \'180 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'2.70 g/cm\302\263\',\n      electricalResistivity: \'3.99 \303\227 10\342\201\273\342\201\270 \316\251\302\267m\',\n      conductivityOrDielectric: \'43.0 % IACS\',\n      magneticOrOptical: \'Non-magnetic / Anodizable\',\n    },\n    processRoutes: buildWroughtMetalRoutes(\'Aluminum 6061\', 640, 480, 415, 6, 310, 276),\n  },\n  {\n    id: \'al-7075\',\n    name: \'Aluminum 7075\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Aluminum alloy\',\n    formula: \'Al-5.6Zn-2.5Mg-1.6Cu-0.23Cr\',\n    crystalStructure: \'FCC + \316\267\342\200\262 (MgZn\342\202\202) Dispersion\',\n    standardCode: \'UNS A97075 / AMS QQ-A-250/12\',\n    overview: \'Ultra-high-strength aerospace Al-Zn-Mg-Cu alloy engineered for primary airframe wing spars, landing gear linkages, and high-stress ordnance components.\',\n    applications: [\'Aircraft wing spars & ribs\', \'Rocket interstage rings\', \'High-load defense receivers\', \'Competition cycling drivetrains\'],\n    mechanical: {\n      tensileStrengthMPa: \'572 MPa\',\n      yieldStrengthMPa: \'503 MPa\',\n      elasticModulusGPa: \'71.7 GPa\',\n      elongationPct: \'11.0 %\',\n      hardness: \'150 HB (Brinell)\',\n      fractureToughness: \'24.0 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'477 \342\200\223 635 \302\260C\',\n      thermalConductivity: \'130 W/m\302\267K\',\n      thermalExpansionCTE: \'23.4 \302\265m/m\302\267K\',\n      specificHeat: \'960 J/kg\302\267K\',\n      maxServiceTempC: \'150 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'2.81 g/cm\302\263\',\n      electricalResistivity: \'5.15 \303\227 10\342\201\273\342\201\270 \316\251\302\267m\',\n      conductivityOrDielectric: \'33.0 % IACS\',\n      magneticOrOptical: \'Paramagnetic\',\n    },\n    processRoutes: buildWroughtMetalRoutes(\'Aluminum 7075\', 625, 450, 413, 5, 572, 503),\n  },\n  {\n    id: \'al-2024\',\n    name: \'Aluminum 2024\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Aluminum alloy\',\n    formula: \'Al-4.4Cu-1.5Mg-0.6Mn\',\n    crystalStructure: \'FCC + S\342\200\262 (Al\342\202\202CuMg) Lath Precipitates\',\n    standardCode: \'UNS A92024 / AMS 4035\',\n    overview: \'High-strength Al-Cu-Mg alloy prized for superior fatigue crack growth resistance and fracture toughness in tension-critical aircraft skin and fuselage structures.\',\n    applications: [\'Commercial aircraft fuselage skins\', \'Tension wing lower panels\', \'Shear webs & rivets\', \'Hydraulic valve bodies\'],\n    mechanical: {\n      tensileStrengthMPa: \'469 MPa\',\n      yieldStrengthMPa: \'324 MPa\',\n      elasticModulusGPa: \'73.1 GPa\',\n      elongationPct: \'19.0 %\',\n      hardness: \'120 HB (Brinell)\',\n      fractureToughness: \'37.0 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'502 \342\200\223 638 \302\260C\',\n      thermalConductivity: \'121 W/m\302\267K\',\n      thermalExpansionCTE: \'23.2 \302\265m/m\302\267K\',\n      specificHeat: \'875 J/kg\302\267K\',\n      maxServiceTempC: \'175 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'2.78 g/cm\302\263\',\n      electricalResistivity: \'5.82 \303\227 10\342\201\273\342\201\270 \316\251\302\267m\',\n      conductivityOrDielectric: \'30.0 % IACS\',\n      magneticOrOptical: \'Non-magnetic\',\n    },\n    processRoutes: buildWroughtMetalRoutes(\'Aluminum 2024\', 630, 455, 413, 5, 469, 324),\n  },\n  {\n    id: \'mg-az31b\',\n    name: \'Magnesium AZ31B\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Magnesium alloy\',\n    formula: \'Mg-3.0Al-1.0Zn-0.2Mn\',\n    crystalStructure: \'HCP (Hexagonal Close-Packed, c/a = 1.624)\',\n    standardCode: \'UNS M11311 / ASTM B90\',\n    overview: \'Ultralight wrought magnesium alloy (35% lighter than aluminum) exhibiting high specific stiffness, electromagnetic shielding, and weldability.\',\n    applications: [\'Ultralight aerospace brackets\', \'Laptop & camera chassis\', \'Biomedical resorbable scaffolds\', \'Vibration damping plates\'],\n    mechanical: {\n      tensileStrengthMPa: \'260 MPa\',\n      yieldStrengthMPa: \'200 MPa\',\n      elasticModulusGPa: \'45.0 GPa\',\n      elongationPct: \'15.0 %\',\n      hardness: \'73 HB (Brinell)\',\n      fractureToughness: \'18.5 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'605 \342\200\223 630 \302\260C\',\n      thermalConductivity: \'96 W/m\302\267K\',\n      thermalExpansionCTE: \'26.0 \302\265m/m\302\267K\',\n      specificHeat: \'1024 J/kg\302\267K\',\n      maxServiceTempC: \'140 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'1.77 g/cm\302\263\',\n      electricalResistivity: \'9.20 \303\227 10\342\201\273\342\201\270 \316\251\302\267m\',\n      conductivityOrDielectric: \'18.5 % IACS\',\n      magneticOrOptical: \'High EMI Attenuation\',\n    },\n    processRoutes: buildWroughtMetalRoutes(\'Magnesium AZ31B\', 625, 380, 345, 5, 260, 200),\n  },\n  // Quick suggestion heroes: Ti-6Al-4V, SiC, Graphene, PEEK, CFRP\n  {\n    id: \'ti-6al-4v\',\n    name: \'Ti-6Al-4V\',\n    category: \'Metals & Alloys\',\n    tagLabel: \'Metal\',\n    subtitle: \'Titanium \316\261+\316\262 alloy\',\n    formula: \'Ti-6Al-4V (Grade 5 / ELI Grade 23)\',\n    crystalStructure: \'Duplex HCP (\316\261) + BCC (\316\262) Phase Network\',\n    standardCode: \'UNS R56400 / AMS 4911 / ASTM F136\',\n    overview: \'Workhorse alpha-beta titanium alloy delivering exceptional strength-to-weight ratio, biocompatibility, and corrosion immunity up to 400 \302\260C.\',\n    applications: [\'Jet engine fan blades & discs\', \'Orthopedic hip/spinal implants\', \'Rocket cryogenic propellant tanks\', \'Subsea pressure hulls\'],\n    mechanical: {\n      tensileStrengthMPa: \'950 MPa\',\n      yieldStrengthMPa: \'880 MPa\',\n      elasticModulusGPa: \'113.8 GPa\',\n      elongationPct: \'14.0 %\',\n      hardness: \'36 HRC (334 HV)\',\n      fractureToughness: \'75.0 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'1604 \342\200\223 1660 \302\260C\',\n      thermalConductivity: \'6.7 W/m\302\267K\',\n      thermalExpansionCTE: \'8.6 \302\265m/m\302\267K\',\n      specificHeat: \'526 J/kg\302\267K\',\n      maxServiceTempC: \'400 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'4.43 g/cm\302\263\',\n      electricalResistivity: \'1.78 \303\227 10\342\201\273\342\201\266 \316\251\302\267m\',\n      conductivityOrDielectric: \'1.0 % IACS\',\n      magneticOrOptical: \'Paramagnetic (MRI Safe)\',\n    },\n    processRoutes: buildCategoryRoutes(\n      \'Ti-6Al-4V\',\n      \'Metals & Alloys\',\n      [\n        \'Vacuum Arc Remelting (VAR) + \316\261/\316\262 Forging\',\n        \'Electron Beam Melting (EBM / 3D Printing)\',\n        \'Laser Powder Bed Fusion (LPBF + HIP)\',\n        \'Beta-Annealed Lamellar Processing\',\n        \'Superplastic Forming & Diffusion Bonding (SPF/DB)\',\n      ],\n      945,\n      \'950 MPa\',\n      \'880 MPa\'\n    ),\n  },\n  {\n    id: \'sic\',\n    name: \'Silicon Carbide (SiC)\',\n    category: \'Ceramics & Glasses\',\n    tagLabel: \'Ceramic\',\n    subtitle: \'Advanced covalent ceramic\',\n    formula: \'SiC (4H / 6H / 3C Polytypes)\',\n    crystalStructure: \'Hexagonal Wurtzite (4H/6H) / Cubic Zincblende (3C)\',\n    standardCode: \'CAS 409-21-2 / ASTM F2393\',\n    overview: \'Ultra-hard wide-bandgap structural and electronic ceramic exhibiting extreme thermal shock resistance, chemical inertness, and high breakdown electric field.\',\n    applications: [\'800V EV traction power MOSFETs\', \'Ballistic armor plates\', \'Gas turbine hot-section seals\', \'Space telescope mirrors\'],\n    mechanical: {\n      tensileStrengthMPa: \'550 MPa (Flexural)\',\n      yieldStrengthMPa: \'3440 MPa (Compressive)\',\n      elasticModulusGPa: \'410 GPa\',\n      elongationPct: \'0.14 %\',\n      hardness: \'2800 HV (Vickers)\',\n      fractureToughness: \'4.6 MPa\302\267m\302\275\',\n    },\n    thermal: {\n      meltingOrTgC: \'2730 \302\260C (Sublimation)\',\n      thermalConductivity: \'120 \342\200\223 380 W/m\302\267K\',\n      thermalExpansionCTE: \'4.0 \302\265m/m\302\267K\',\n      specificHeat: \'750 J/kg\302\267K\',\n      maxServiceTempC: \'1650 \302\260C\',\n    },\n    electricalAndPhysical: {\n      densityGcm3: \'3.21 g/cm\302\263\',\n      electricalResistivity: \'10\302\262 \342\200\223 10\342\201\266 \316\251\302\267m (Doping Dependent)\',\n      conductivityOrDielectric: \'Bandgap 3.26 eV (4H-SiC)\',\n      magneticOrOptical: \'Refractive Index n = 2.65\',\n    },\n    processRoutes: buildCategoryRoutes(\n      \'Silicon Carbide (SiC)\',\n      \'Ceramics & Glasses\',\n      [\n        \'Physical Vapor Transport (PVT / Lely Boule Growth)\',\n        \'Pressureless Solid-State Sintering (SSiC)\',\n        \'Hot Isostatic Pressing (HIP-SiC)\',\n        \'Chemical Vapor Deposition (CVD Cubic \316\262-SiC)\',\n        \'Reaction-Bonded Silicon Infiltration (RBSC)\',\n      ],\n      2150,\n      \'550 MPa\',\n      \'3440 MPa\'\n    ),\n  },\n  {\n    id: \'graphene\',\n    name: \'Graphene (Monolayer / Few-Layer)\',\n    category: \'Carbon Materials\',\n    tagLabel: \'Carbon\',\n    subtitle: \'2D sp\302\262 carbon allotrope\',\n    formula: \'C (2D Honeycomb Lattice)\',\n    crystalStructure: \'2D Hexagonal sp\302\262 Hybridized Sheet (C\342\200\223C = 0.142 nm)\',\n    standardCode: \'ISO/TS 80004-13 / CAS 1034343-98-0\',\n    overview: \'Atomically thin two-dimensional carbon crystal possessing the highest known intrinsic tensile strength, ballistic room-temperature electron mobility, and phonon thermal conductivity.\',\n    applications: [\'THz high-frequency photodetectors\', \'Solid-state battery anodes\', \'Nanocomposite barrier coatings\', \'Quantum Hall metrology\'],\n    mechanical: {\n      tensileStrengthMPa: \'130,000 MPa (Intrinsic)\',\n      yieldStrengthMPa: \'110,000 MPa\