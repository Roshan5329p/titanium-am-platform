        instruction: "import React from \'react\';\nimport { NavSection } from \'../types\';\n\ninterface FooterProps {\n  onNavigate: (section: NavSection) => void;\n  onOpenDemo: () => void;\n  onOpenStartFree: () => void;\n}\n\nexport function Footer({ onNavigate, onOpenDemo, onOpenStartFree }: FooterProps) {\n  return (\n    <footer className=\"bg-[#0d0e0f] border-t border-[#232426] flex flex-col justify-between px-4 sm:px-8 pt-20 pb-12 text-left\">\n      <div className=\"max-w-[1728px] w-full mx-auto grid grid-cols-2 md:grid-cols-6 gap-10 lg:gap-12 mb-16\">\n        {/* Brand block (2 cols) */}\n        <div className=\"col-span-2\">\n          <div className=\"flex items-center gap-2.5 mb-5\">\n            <div className=\"w-6 h-6 rounded-full border border-[#9A9DA3] flex items-center justify-center text-[#e5e2e3] font-h3 font-bold text-[12px]\">\n              R\n            </div>\n            <span className=\"font-h3 text-xl font-bold text-[#e5e2e3] tracking-tight\">\n              Romer\n            </span>\n          </div>\n          <p className=\"text-sm font-body-md text-[#9A9DA3] max-w-xs leading-relaxed mb-6\">\n            The operating layer for focused teams.\n          </p>\n          <div className=\"text-[11px] font-mono-data text-[#9A9DA3]/50\">\n            SYSTEM_SYNC: ACTIVE // VER 3.4.1\n          </div>\n        </div>\n\n        {/* PRODUCT */}\n        <div className=\"flex flex-col gap-2.5\">\n          <div className=\"font-mono-data text-[#9A9DA3] mb-2 text-xs tracking-wider uppercase\">\n            PRODUCT\n          </div>\n          <button onClick={() => onNavigate(\'Platform\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Overview\n          </button>\n          <button onClick={() => onNavigate(\'Dashboards\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Features\n          </button>\n          <button onClick={() => onNavigate(\'Resources\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Security\n          </button>\n        </div>\n\n        {/* PLATFORM */}\n        <div className=\"flex flex-col gap-2.5\">\n          <div className=\"font-mono-data text-[#9A9DA3] mb-2 text-xs tracking-wider uppercase\">\n            PLATFORM\n          </div>\n          <button onClick={() => onNavigate(\'Dashboards\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Integrations\n          </button>\n          <button onClick={() => onNavigate(\'Resources\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            API\n          </button>\n          <button onClick={() => onNavigate(\'Dashboards\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Status\n          </button>\n        </div>\n\n        {/* COMPANY */}\n        <div className=\"flex flex-col gap-2.5\">\n          <div className=\"font-mono-data text-[#9A9DA3] mb-2 text-xs tracking-wider uppercase\">\n            COMPANY\n          </div>\n          <button onClick={() => onNavigate(\'Customers\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            About\n          </button>\n          <button onClick={() => onOpenDemo()} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Careers\n          </button>\n          <button onClick={() => onNavigate(\'Resources\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Blog\n          </button>\n        </div>\n\n        {/* RESOURCES */}\n        <div className=\"flex flex-col gap-2.5\">\n          <div className=\"font-mono-data text-[#9A9DA3] mb-2 text-xs tracking-wider uppercase\">\n            RESOURCES\n          </div>\n          <button onClick={() => onNavigate(\'Resources\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Documentation\n          </button>\n          <button onClick={() => onOpenStartFree()} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Quickstart\n          </button>\n          <button onClick={() => onNavigate(\'Pricing\')} className=\"text-left font-body-md text-sm text-[#e5e2e3] hover:text-[#bec2ff] transition-colors\">\n            Pricing\n          </button>\n        </div>\n      </div>\n\n      <div className=\"max-w-[1728px] w-full mx-auto border-t border-[#232426] pt-8 flex flex-col sm:flex-row justify-between items-center text-xs font-mono-data text-[#9A9DA3]/50 gap-4\">\n        <div>\n          \302\251 {new Date().getFullYear()} Romer Technologies Inc. All rights reserved.\n        </div>\n        <div className=\"flex items-center gap-6\">\n          <span className=\"hover:text-white cursor-pointer transition-colors\">Privacy Notice</span>\n          <span className=\"hover:text-white cursor-pointer transition-colors\">Terms of Command</span>\n          <span className=\"hover:text-white cursor-pointer transition-colors\">System Telemetry (99.999%)</span>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"
