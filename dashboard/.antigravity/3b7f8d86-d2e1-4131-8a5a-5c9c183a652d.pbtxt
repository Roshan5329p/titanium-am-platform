            }
            lines {
              text: "      coolingRate: idx === 0 ? \'15 \302\260C/min (Controlled)\' : idx === 1 ? \'180 \302\260C/s (Rapid Quench)\' : \'5 \302\260C/min (Equilibrium)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
