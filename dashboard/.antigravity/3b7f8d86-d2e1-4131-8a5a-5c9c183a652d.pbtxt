  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { CheckCircle2, TrendingUp, AlertTriangle, Clock } from \'lucide-react\';\n\ninterface InsightNode {\n  id: number;\n  title: string;\n  desc: string;\n  metric: string;\n  metricLabel: string;\n  detail: string;\n}\n\nexport function InsightsTimelineSection() {\n  const [activeNodeId, setActiveNodeId] = useState<number>(1);\n\n  const nodes: InsightNode[] = [\n    {\n      id: 1,\n      title: \'Approval cycles\',\n      desc: \'Reduce bottlenecks in critical sign-offs.\',\n      metric: \'-42% Cycle Time\',\n      metricLabel: \'From 3.8 days to 5.2 hours\',\n      detail: \'Automated policy-based delegations ensure architectural and budgetary approvals never sit in idle queues.\',\n    },\n    {\n      id: 2,\n      title: \'Capacity forecast\',\n      desc: \'Predict resource needs ahead of time.\',\n      metric: \'94.8% Accuracy\',\n      metricLabel: \'Multi-sprint velocity regression\',\n      detail: \'Ingests historical PR turnaround, story point completion, and cloud quota demand to forecast engineering capacity 6 weeks out.\',\n    },\n    {\n      id: 3,\n      title: \'Risk movement\',\n      desc: \'Track shifting risk profiles continuously.\',\n      metric: \'Early Warning\',\n      metricLabel: \'Proactive degradation signals\',\n      detail: \'Monitors PR churn, CI flake rates, and third-party API latency shifts before they breach enterprise SLO thresholds.\',\n    },\n    {\n      id: 4,\n      title: \'Operating rhythm\',\n      desc: \'Establish a steady heartbeat for execution.\',\n      metric: \'Zero-Meeting Sync\',\n      metricLabel: \'Automated executive rollups\',\n      detail: \'Replaces asynchronous status documents and fragmented Slack channels with a deterministic daily operational pulse.\',\n    },\n  ];\n\n  const activeNode = nodes.find(n => n.id === activeNodeId) || nodes[0];\n\n  return (\n    <section className=\"px-4 sm:px-8 border-t border-[#232426] flex flex-col justify-center relative overflow-hidden py-20 max-w-[1728px] mx-auto\">\n      <div className=\"max-w-[1516px] w-full mx-auto relative pt-12 sm:pt-20\">\n        {/* Connecting Horizontal Line */}\n        <div className=\"hidden md:block absolute top-[94px] sm:top-[128px] left-0 w-full h-px bg-[#232426] z-0\"></div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 relative z-10\">\n          {nodes.map((node) => {\n            const isActive = activeNodeId === node.id;\n            return (\n              <div\n                key={node.id}\n                onClick={() => setActiveNodeId(node.id)}\n                className=\"relative flex flex-col items-center text-center cursor-pointer group p-4 rounded-xl hover:bg-[#101112]/40 transition-colors\"\n              >\n                {/* Visual Node Indicator */}\n                {isActive ? (\n                  <div className=\"w-5 h-5 rounded-full bg-[#5E6BFF] mb-6 relative z-10 shadow-[0_0_15px_#5E6BFF] border-2 border-white flex items-center justify-center transition-all\">\n                    <div className=\"w-1.5 h-1.5 rounded-full bg-white\"></div>\n                  </div>\n                ) : (\n                  <div className=\"w-3.5 h-3.5 rounded-full bg-[#232426] border border-[#9A9DA3] mb-6 mt-1 relative z-10 group-hover:border-[#5E6BFF] group-hover:scale-110 transition-all\"></div>\n                )}\n\n                <h3 className={`font-h4 text-lg mb-2 transition-colors ${isActive ? \'text-white font-bold\' : \'text-[#e5e2e3] group-hover:text-white\'}`}>\n                  {node.title}\n                </h3>\n                <p className=\"font-body-md text-sm text-[#9A9DA3] leading-relaxed max-w-xs\">\n                  {node.desc}\n                </p>\n                <span className={`text-[10px] font-mono-data mt-3 uppercase tracking-wider transition-opacity ${isActive ? \'text-[#bec2ff] opacity-100\' : \'text-[#9A9DA3]/50 opacity-0 group-hover:opacity-100\'}`}>\n                  Inspect Data \342\206\223\n                </span>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Selected Dimension Technical Card */}\n        <div className=\"mt-12 p-6 sm:p-8 bg-[#101112] border border-[#232426] rounded-xl inner-glow max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6\">\n          <div className=\"space-y-2 max-w-xl text-left\">\n            <div className=\"flex items-center gap-2 text-xs font-mono-data text-[#50d8e9]\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#50d8e9]\"></span>\n              <span>DIMENSION_0{activeNode.id} // {activeNode.title.toUpperCase()}</span>\n            </div>\n            <p className=\"text-sm font-body-md text-[#c6c5d8] leading-relaxed\">\n              {activeNode.detail}\n            </p>\n          </div>\n          <div className=\"border-t md:border-t-0 md:border-l border-[#232426] pt-4 md:pt-0 md:pl-8 text-left md:text-right shrink-0\">\n            <span className=\"text-2xl sm:text-3xl font-h3 font-bold text-white block\">\n              {activeNode.metric}\n            </span>\n            <span className=\"text-xs font-mono-data text-[#9A9DA3]\">\n              {activeNode.metricLabel}\n            </span>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/InsightsTimelineSection.tsx"
        }
        overwrite: true
      }
    }
