  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { ArrowRight, Play, Pause, Activity } from \'lucide-react\';\n\ninterface HeroSectionProps {\n  onGetStarted: () => void;\n  onBookDemo: () => void;\n  onOpenLiveDashboard: () => void;\n}\n\nexport function HeroSection({\n  onGetStarted,\n  onBookDemo,\n  onOpenLiveDashboard,\n}: HeroSectionProps) {\n  const [isPlaying, setIsPlaying] = useState(true);\n  const [latency, setLatency] = useState(1.24);\n  const [throughput, setThroughput] = useState(124.9);\n  const [hoveredPoint, setHoveredPoint] = useState<{ x: number; y: number; label: string; val: string } | null>(null);\n  const [timeIndex, setTimeIndex] = useState(1);\n  const [mousePos, setMousePos] = useState({ x: 0, y: 0, active: false });\n\n  // Subtle real-time oscillation to make the telemetry feel genuinely live\n  useEffect(() => {\n    if (!isPlaying) return;\n\n    const interval = setInterval(() => {\n      setLatency(prev => +(1.22 + Math.random() * 0.05).toFixed(2));\n      setThroughput(prev => +(124.7 + Math.random() * 0.4).toFixed(1));\n      setTimeIndex(prev => (prev % 99) + 1);\n    }, 1800);\n\n    return () => clearInterval(interval);\n  }, [isPlaying]);\n\n  return (\n    <section className=\"px-4 sm:px-8 relative pt-20 sm:pt-28 pb-16 sm:pb-20 max-w-[1728px] mx-auto\">\n      <div className=\"max-w-[1516px] mx-auto\">\n        {/* Hero Copy & Live layer link */}\n        <div className=\"flex flex-col lg:flex-row lg:justify-between lg:items-end mb-10 sm:mb-14 gap-6\">\n          <div className=\"max-w-4xl\">\n            <h1 className=\"font-h1 text-4xl sm:text-6xl lg:text-[76px] text-[#e5e2e3] mb-4 sm:mb-6 tracking-tight leading-[1.08]\">\n              The command dashboard<br className=\"hidden sm:inline\" />\n              for focused teams\n            </h1>\n            <p className=\"font-body-lg text-lg sm:text-[19px] text-[#9A9DA3] mb-8 max-w-2xl leading-relaxed\">\n              Romer turns scattered signals, approvals, and operating data into one calm dashboard for leadership teams.\n            </p>\n            <div className=\"flex flex-wrap items-center gap-4\">\n              <button\n                onClick={onGetStarted}\n                className=\"bg-white text-black px-6 py-3.5 rounded font-body-lg font-bold hover:bg-[#e0e0e0] transition-colors shadow-lg active:scale-[0.98]\"\n              >\n                Get started\n              </button>\n              <button\n                onClick={onBookDemo}\n                className=\"bg-[#1a1b1d] border border-[#232426] text-[#e5e2e3] px-6 py-3.5 rounded font-body-lg hover:bg-[#101112] hover:border-[#5E6BFF]/40 transition-colors active:scale-[0.98]\"\n              >\n                Book a demo\n              </button>\n            </div>\n          </div>\n\n          <div className=\"text-left lg:text-right pb-2\">\n            <button\n              onClick={onOpenLiveDashboard}\n              className=\"text-[#9A9DA3] font-mono-data text-xs sm:text-sm hover:text-[#bec2ff] inline-flex items-center gap-2 group transition-colors py-1 border-b border-transparent hover:border-[#bec2ff]/40\"\n            >\n              <span>Live operating layer romer.app/overview</span>\n              <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform text-[#50d8e9]\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Hero Dashboard Mockup Frame */}\n        <div className=\"w-full bg-[#101112] rounded-xl border border-white/[0.05] overflow-hidden flex flex-col h-[540px] sm:h-[620px] inner-glow shadow-2xl relative\">\n          <div className=\"flex-1 flex flex-col bg-[#070708] relative overflow-hidden\">\n            {/* Technical Header */}\n            <div className=\"flex justify-between items-center px-6 sm:px-10 py-5 sm:py-6 border-b border-white/[0.03] z-20 bg-[#070708]/80 backdrop-blur-sm\">\n              <div className=\"flex items-center gap-4 sm:gap-6\">\n                <div className=\"flex flex-col\">\n                  <span className=\"text-[9px] font-mono-data text-[#9A9DA3]/50 uppercase tracking-[0.2em]\">\n                    System Status\n                  </span>\n                  <span className=\"text-xs font-mono-data text-[#50d8e9]/90 font-medium tracking-wider\">\n                    OPERATIONAL // 0xAF92\n                  </span>\n                </div>\n                <div className=\"w-px h-8 bg-white/[0.05]\"></div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-[9px] font-mono-data text-[#9A9DA3]/50 uppercase tracking-[0.2em]\">\n                    Core Latency\n                  </span>\n                  <span className=\"text-xs font-mono-data text-[#e5e2e3]/70 font-mono\">\n                    {latency}ms\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4\">\n                <button\n                  onClick={() => setIsPlaying(!isPlaying)}\n                  className=\"hidden sm:flex items-center gap-1.5 text-[10px] font-mono-data text-[#9A9DA3] hover:text-white px-2 py-1 border border-white/[0.05] rounded hover:bg-white/[0.03] transition-colors\"\n                  title={isPlaying ? \'Pause telemetry updates\' : \'Resume live stream\'}\n                >\n                  {isPlaying ? <Pause className=\"w-3 h-3 text-[#50d8e9]\" /> : <Play className=\"w-3 h-3 text-[#bec2ff]\" />}\n                  <span>{isPlaying ? \'STREAM ACTIVE\' : \'PAUSED\'}</span>\n                </button>\n\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[9px] font-mono-data text-[#9A9DA3]/60 uppercase tracking-[0.2em] hidden sm:inline\">\n                    Last Sync: 0.002s ago\n                  </span>\n                  <div \n                    className=\"w-1.5 h-1.5 rounded-full bg-[#50d8e9] shadow-[0_0_8px_rgba(80,216,233,0.7)] animate-pulse\"\n                    title=\"Live websocket sync heartbeat\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Main Interactive Visualization Area */}\n            <div \n              className=\"flex-1 relative cursor-crosshair select-none overflow-hidden\"\n              onMouseMove={(e) => {\n                const rect = e.currentTarget.getBoundingClientRect();\n                setMousePos({\n                  x: e.clientX - rect.left,\n                  y: e.clientY - rect.top,\n                  active: true,\n                });\n              }}\n              onMouseLeave={() => setMousePos(prev => ({ ...prev, active: false }))}\n            >\n              {/* Ultra-fine Grid Backgrounds */}\n              <div \n                className=\"absolute inset-0 pointer-events-none\" \n                style={{ \n                  backgroundImage: \'radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px)\', \n                  backgroundSize: \'40px 40px\' \n                }} \n              />\n              <div \n                className=\"absolute inset-0 pointer-events-none\" \n                style={{ \n                  backgroundImage: \'linear-gradient(to right, rgba(255,255,255,0.01) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.01) 1px, transparent 1px)\', \n                  backgroundSize: \'160px 160px\' \n                }} \n              />\n\n              {/* Precise Line Art SVG */}\n              <div className=\"absolute inset-0 flex items-center justify-center p-6 sm:p-16\">\n                <svg \n                  className=\"w-full h-full opacity-70\" \n                  preserveAspectRatio=\"none\" \n                  viewBox=\"0 0 1000 400\"\n                >\n                  {/* Subtle Grid reference markers */}\n                  <line opacity=\"0.1\" stroke=\"white\" strokeWidth=\"0.5\" x1=\"0\" x2=\"1000\" y1=\"100\" y2=\"100\" strokeDasharray=\"3 3\" />\n                  <line opacity=\"0.1\" stroke=\"white\" strokeWidth=\"0.5\" x1=\"0\" x2=\"1000\" y1=\"200\" y2=\"200\" strokeDasharray=\"3 3\" />\n                  <line opacity=\"0.15\" stroke=\"white\" strokeWidth=\"0.5\" x1=\"0\" x2=\"1000\" y1=\"350\" y2=\"350\" />\n\n                  {/* Abstract Data Thread 1 (Dashed Indigo) */}\n                  <path \n                    d=\"M0,200 L100,180 L250,220 L400,140 L550,260 L700,100 L850,240 L1000,160\" \n                    fill=\"none\" \n                    opacity=\"0.5\" \n                    stroke=\"#5E6BFF\" \n                    strokeDasharray=\"3 4\" \n                    strokeWidth=\"1.2\" \n                  />\n\n                  {/* Abstract Data Thread 2 (Primary Cyan Spline) */}\n                  <path \n                    d=\"M0,250 C150,250 250,150 400,150 C550,150 650,300 800,300 C950,300 1000,200 1000,200\" \n                    fill=\"none\" \n                    stroke=\"#50d8e9\" \n                    strokeWidth=\"1.6\" \n                  />\n\n                  {/* Sparse Data Points */}\n                  <g className=\"cursor-pointer\">\n                    <circle \n                      cx=\"400\" \n                      cy=\"150\" \n                      fill=\"#50d8e9\" \n                      r=\"4\" \n                      className=\"hover:r-6 transition-all\"\n                      onMouseEnter={() => setHoveredPoint({ x: 400, y: 150, label: \'P_OPTIMAL_SYNC\', val: \'Delta: 0.00ms // Invariant Safe\' })}\n                      onMouseLeave={() => setHoveredPoint(null)}\n                    />\n                    <circle cx=\"400\" cy=\"150\" fill=\"none\" stroke=\"#50d8e9\" strokeWidth=\"0.5\" r=\"9\" opacity=\"0.4\" />\n                  </g>\n\n                  <g className=\"cursor-pointer\">\n                    <circle \n                      cx=\"800\" \n                      cy=\"300\" \n                      fill=\"#5E6BFF\" \n                      r=\"4\" \n                      className=\"hover:r-6 transition-all\"\n                      onMouseEnter={() => setHoveredPoint({ x: 800, y: 300, label: \'\316\224_MARGINAL_VAR\', val: \'+0.12% variance tolerance\' })}\n                      onMouseLeave={() => setHoveredPoint(null)}\n                    />\n                    <circle cx=\"800\" cy=\"300\" fill=\"none\" stroke=\"#5E6BFF\" strokeWidth=\"0.5\" r=\"9\" opacity=\"0.4\" />\n                  </g>\n\n                  <circle cx=\"150\" cy=\"210\" fill=\"white\" opacity=\"0.3\" r=\"2\" />\n                  <circle cx=\"550\" cy=\"260\" fill=\"white\" opacity=\"0.25\" r=\"2\" />\n                  <circle cx=\"700\" cy=\"100\" fill=\"#50d8e9\" opacity=\"0.4\" r=\"2\" />\n\n                  {/* Technical Callouts with connection lines */}\n                  <g transform=\"translate(415, 140)\">\n                    <text fill=\"#50d8e9\" fontFamily=\"Inter\" fontSize=\"9\" fontWeight=\"bold\" opacity=\"0.85\">\n                      P_OPTIMAL_SYNC\n                    </text>\n                    <line opacity=\"0.5\" stroke=\"#50d8e9\" strokeWidth=\"0.5\" x1=\"-10\" x2=\"-3\" y1=\"10\" y2=\"3\" />\n                  </g>\n\n                  <g transform=\"translate(815, 290)\">\n                    <text fill=\"#bec2ff\" fontFamily=\"Inter\" fontSize=\"9\" fontWeight=\"bold\" opacity=\"0.85\">\n                      \316\224_MARGINAL_VAR\n                    </text>\n                    <line opacity=\"0.5\" stroke=\"#5E6BFF\" strokeWidth=\"0.5\" x1=\"-10\" x2=\"-3\" y1=\"10\" y2=\"3\" />\n                  </g>\n                </svg>\n              </div>\n\n              {/* Dynamic mouse crosshair indicator */}\n              {mousePos.active && (\n                <div \n                  className=\"absolute pointer-events-none transform -translate-x-1/2 -translate-y-1/2\"\n                  style={{ left: mousePos.x, top: mousePos.y }}\n                >\n                  <div className=\"w-8 h-8 rounded-full border border-white/20 flex items-center justify-center\">\n                    <div className=\"w-1 h-1 bg-[#50d8e9] rounded-full\"></div>\n                  </div>\n                  <span className=\"absolute left-6 -top-2 text-[9px] font-mono-data bg-[#101112]/90 border border-[#232426] px-1.5 py-0.5 rounded text-[#9A9DA3] whitespace-nowrap\">\n                    COORD: {(mousePos.x * 0.1).toFixed(1)} // {(mousePos.y * 0.1).toFixed(1)}\n                  </span>\n                </div>\n              )}\n\n              {/* Floating Tooltip when hovering key nodes */}\n              {hoveredPoint && (\n                <div \n                  className=\"absolute z-30 p-2.5 bg-[#0d0e0f]/95 border border-[#50d8e9]/40 rounded shadow-xl text-left pointer-events-none backdrop-blur-md\"\n                  style={{ \n                    left: `${(hoveredPoint.x / 1000) * 100}%`, \n                    top: `${(hoveredPoint.y / 400) * 100 - 15}%` \n                  }}\n                >\n                  <div className=\"text-[10px] font-mono-data text-[#50d8e9] font-bold\">{hoveredPoint.label}</div>\n                  <div className=\"text-[9px] font-mono-data text-[#9A9DA3]\">{hoveredPoint.val}</div>\n                </div>\n              )}\n\n              {/* Floating Technical Info Cards (Left) */}\n              <div className=\"absolute top-6 sm:top-10 left-6 sm:left-12 space-y-6 sm:space-y-7 z-10\">\n                <div className=\"border-l-2 border-[#50d8e9]/50 pl-3 sm:pl-4 py-0.5 bg-[#070708]/60 backdrop-blur-sm pr-4 rounded-r\">\n                  <span className=\"block text-[8px] font-mono-data text-[#9A9DA3]/60 uppercase tracking-widest\">\n                    Throughput\n                  </span>\n                  <span className=\"text-sm sm:text-base font-mono-data text-white font-medium\">\n                    {throughput} GB/S\n                  </span>\n                </div>\n    