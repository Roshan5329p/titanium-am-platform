  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { ControlQueueItem } from \'../types\';\nimport { Check, ArrowRight } from \'lucide-react\';\n\ninterface DecisionCommandSectionProps {\n  onOpenDecisionReview: (item: ControlQueueItem) => void;\n}\n\nexport function DecisionCommandSection({ onOpenDecisionReview }: DecisionCommandSectionProps) {\n  // Interactive scanning line position (percentage)\n  const [scanPos, setScanPos] = useState<number>(42);\n  const [activeMonth, setActiveMonth] = useState<string>(\'SEP_24\');\n\n  // Control Queue state\n  const [queueItems, setQueueItems] = useState<ControlQueueItem[]>([\n    {\n      id: \'q1\',\n      code: \'Q4_STRATEGIC_OKRS\',\n      title: \'Finalize Q4 Strategic Objectives & Resource Balancing\',\n      priority: \'High\',\n      signalsCount: 2,\n      status: \'pending\',\n      owner: \'Elena Rostova (VP Product)\',\n      impact: \'Aligns 6 product teams on multi-tenant isolation roadmap for enterprise SLA guarantees.\',\n      date: \'2026-09-18\',\n    },\n    {\n      id: \'q2\',\n      code: \'HIRING_V4_SCALE\',\n      title: \'Infrastructure & Platform Lead Headcount Authorization\',\n      priority: \'Med\',\n      signalsCount: 5,\n      status: \'pending\',\n      owner: \'David Kim (Director of Eng)\',\n      impact: \'Unblocks distributed caching and real-time Kafka partition scaling for Q1 volume surges.\',\n      date: \'2026-09-22\',\n    },\n    {\n      id: \'q3\',\n      code: \'INFRA_AUDIT_Q3\',\n      title: \'Quarterly Cloud Cost Allocation & Kubernetes Re-binning\',\n      priority: \'Low\',\n      signalsCount: 1,\n      status: \'pending\',\n      owner: \'Marcus Vance (FinOps)\',\n      impact: \'Recovers estimated $18.4k/mo in idle memory reservations across staging clusters.\',\n      date: \'2026-09-28\',\n    },\n  ]);\n\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const handleExecute = (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setQueueItems(prev =>\n      prev.map(item =>\n        item.id === id ? { ...item, status: \'executed\' as const } : item\n      )\n    );\n    const item = queueItems.find(q => q.id === id);\n    setToastMessage(`Executed: ${item?.code} directives dispatched.`);\n    setTimeout(() => setToastMessage(null), 3000);\n  };\n\n  const handleTimelineClick = (pos: number, month: string) => {\n    setScanPos(pos);\n    setActiveMonth(month);\n  };\n\n  return (\n    <section className=\"px-4 sm:px-8 border-t border-[#232426] flex items-center relative py-20 max-w-[1728px] mx-auto\">\n      {toastMessage && (\n        <div className=\"fixed bottom-6 right-6 z-50 bg-[#101112] border border-[#50d8e9]/50 text-white px-4 py-2.5 rounded shadow-2xl flex items-center gap-2 text-xs font-mono-data animate-in fade-in slide-in-from-bottom-2\">\n          <Check className=\"w-4 h-4 text-[#50d8e9]\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      <div className=\"max-w-[1516px] w-full mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center\">\n        {/* Left Column: Interactive Technical Hub & Timeline */}\n        <div className=\"relative h-[620px] w-full order-2 lg:order-1\">\n          {/* Main Dashboard Background */}\n          <div className=\"absolute inset-0 bg-[#0a0a0b] border border-white/[0.05] rounded-xl overflow-hidden flex flex-col inner-glow shadow-2xl\">\n            {/* Top Timeline Section */}\n            <div className=\"p-6 border-b border-white/[0.03] relative h-[45%] bg-[#080809] select-none\">\n              <div className=\"absolute inset-0 dot-pattern opacity-[0.03] pointer-events-none\"></div>\n\n              {/* Month Markers (Interactive) */}\n              <div className=\"flex justify-between text-mono-data text-[9px] text-[#9A9DA3]/50 mb-8 border-b border-white/[0.03] pb-2 uppercase tracking-[0.25em]\">\n                {[\n                  { label: \'AUG_24\', pos: 15 },\n                  { label: \'SEP_24\', pos: 42 },\n                  { label: \'OCT_24\', pos: 68 },\n                  { label: \'NOV_24\', pos: 90 },\n                ].map((m) => (\n                  <button\n                    key={m.label}\n                    onClick={() => handleTimelineClick(m.pos, m.label)}\n                    className={`transition-colors font-mono hover:text-white ${\n                      activeMonth === m.label ? \'text-[#e5e2e3] font-bold\' : \'\'\n                    }`}\n                  >\n                    {m.label}\n                  </button>\n                ))}\n              </div>\n\n              {/* Timeline Bars */}\n              <div className=\"relative h-full\">\n                {/* Phase 01 */}\n                <div className=\"absolute top-0 left-[5%] w-[35%] h-[1px] bg-white/[0.1] flex items-center\">\n                  <div className=\"w-1.5 h-1.5 bg-white/[0.4] rounded-full -ml-0.5\"></div>\n                  <span className=\"ml-3 text-[9px] font-mono-data text-[#9A9DA3]/60 uppercase tracking-widest whitespace-nowrap\">\n                    PHASE_01 // DISCOVERY\n                  </span>\n                </div>\n\n                {/* Phase 02 */}\n                <div className=\"absolute top-12 left-[30%] w-[55%] h-[1px] bg-[#5E6BFF]/30 flex items-center\">\n                  <div className=\"w-1.5 h-1.5 bg-[#5E6BFF] rounded-full -ml-0.5\"></div>\n                  <span className=\"ml-3 text-[9px] font-mono-data text-[#bec2ff] uppercase tracking-widest whitespace-nowrap\">\n                    PHASE_02 // DEPLOYMENT_SYNC\n                  </span>\n                </div>\n\n                {/* Post Q4 */}\n                <div className=\"absolute top-24 left-[70%] w-[25%] h-[1px] bg-white/[0.05] border-t border-dashed border-white/[0.2] flex items-center\">\n                  <span className=\"ml-3 text-[9px] font-mono-data text-[#9A9DA3]/40 uppercase tracking-widest whitespace-nowrap\">\n                    TBD_POST_Q4\n                  </span>\n                </div>\n\n                {/* Vertical Scanning Line */}\n                <div \n                  className=\"absolute inset-y-0 w-px bg-[#5E6BFF]/60 shadow-[0_0_12px_rgba(94,107,255,0.5)] z-10 transition-all duration-300\"\n                  style={{ left: `${scanPos}%` }}\n                >\n                  <div className=\"absolute top-0 -translate-x-1/2 w-2.5 h-2.5 border border-[#5E6BFF] bg-[#0a0a0b] shadow-sm\"></div>\n                  <div className=\"absolute bottom-1 -translate-x-1/2 text-[8px] font-mono-data text-[#5E6BFF] whitespace-nowrap px-1 bg-[#0a0a0b] border border-[#5E6BFF]/30\">\n                    {activeMonth}\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Technical Hub */}\n            <div className=\"flex-1 grid grid-cols-1 sm:grid-cols-2 gap-px bg-white/[0.03]\">\n              {/* Metrics Hub: Instrument Grade */}\n              <div className=\"bg-[#0a0a0b] p-6 flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex justify-between items-center mb-4\">\n                    <div className=\"text-mono-data text-[9px] text-[#9A9DA3]/70 uppercase font-bold tracking-[0.2em]\">\n                      Operational telemetry\n                    </div>\n                    <div className=\"text-[8px] font-mono-data text-[#50d8e9]/70\">\n                      REFRESH: 200MS\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"flex flex-col gap-1\">\n                      <span className=\"text-[8px] text-[#9A9DA3]/50 uppercase tracking-wider\">Velocity</span>\n                      <span className=\"text-sm font-mono-data text-white font-medium\">14.28</span>\n                    </div>\n                    <div className=\"flex flex-col gap-1\">\n                      <span className=\"text-[8px] text-[#9A9DA3]/50 uppercase tracking-wider\">Latency</span>\n                      <span className=\"text-sm font-mono-data text-[#50d8e9] font-medium\">4.2ms</span>\n                    </div>\n                    <div className=\"flex flex-col gap-1\">\n                      <span className=\"text-[8px] text-[#9A9DA3]/50 uppercase tracking-wider\">Queue</span>\n                      <span className=\"text-sm font-mono-data text-white font-medium\">09</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-4 h-16 border border-white/[0.03] rounded bg-[#080809] relative overflow-hidden flex items-end\">\n                  <div \n                    className=\"absolute inset-0 opacity-10 pointer-events-none\" \n                    style={{ \n                      backgroundImage: \'linear-gradient(#454655 0.5px, transparent 0.5px), linear-gradient(to right, #454655 0.5px, transparent 0.5px)\', \n                      backgroundSize: \'20px 20px\' \n                    }}\n                  ></div>\n                  <svg className=\"w-full h-full\" preserveAspectRatio=\"none\" viewBox=\"0 0 100 40\">\n                    <path \n                      d=\"M0,35 L10,32 L20,36 L30,28 L40,30 L50,15 L60,25 L70,22 L80,30 L90,20 L100,25\" \n                      fill=\"none\" \n                      opacity=\"0.7\" \n                      stroke=\"#50d8e9\" \n                      strokeWidth=\"0.75\" \n                    />\n                    <path d=\"M0,40 L100,40\" opacity=\"0.2\" stroke=\"white\" strokeWidth=\"0.1\" />\n                  </svg>\n                  <div className=\"absolute bottom-1 right-2 text-[7px] font-mono-data text-[#9A9DA3]/40\">\n                    BIT_STREAM_72.04\n                  </div>\n                </div>\n              </div>\n\n              {/* Decision Schematic */}\n              <div className=\"bg-[#0a0a0b] p-6 flex flex-col justify-between\">\n                <div className=\"text-mono-data text-[9px] text-[#9A9DA3]/70 uppercase font-bold tracking-[0.2em] mb-2\">\n                  Decision Logic schematic\n                </div>\n                <div className=\"flex-1 flex items-center justify-center relative\">\n                  <svg className=\"w-full h-full\" viewBox=\"0 0 200 120\">\n                    {/* Central Node */}\n                    <circle cx=\"100\" cy=\"60\" fill=\"#5E6BFF\" r=\"3\" />\n                    <circle cx=\"100\" cy=\"60\" fill=\"none\" r=\"9\" stroke=\"#5E6BFF\" strokeWidth=\"0.5\" />\n\n                    {/* Branches */}\n                    <path d=\"M100,60 L60,40\" opacity=\"0.3\" stroke=\"white\" strokeWidth=\"0.5\" />\n                    <path d=\"M100,60 L140,40\" opacity=\"0.3\" stroke=\"white\" strokeWidth=\"0.5\" />\n                    <path d=\"M100,60 L100,100\" opacity=\"0.3\" stroke=\"white\" strokeDasharray=\"2 1\" strokeWidth=\"0.5\" />\n\n                    {/* End Nodes */}\n                    <rect fill=\"none\" height=\"12\" opacity=\"0.4\" stroke=\"white\" strokeWidth=\"0.5\" width=\"12\" x=\"54\" y=\"34\" />\n                    <rect fill=\"none\" height=\"12\" opacity=\"0.4\" stroke=\"white\" strokeWidth=\"0.5\" width=\"12\" x=\"134\" y=\"34\" />\n                    <circle cx=\"100\" cy=\"100\" fill=\"#ffb689\" opacity=\"0.6\" r=\"2.5\" />\n\n                    {/* Labels */}\n                    <text fill=\"#9A9DA3\" fontFamily=\"monospace\" fontSize=\"4.5\" opacity=\"0.7\" x=\"53\" y=\"30\">INPUT_A</text>\n                    <text fill=\"#9A9DA3\" fontFamily=\"monospace\" fontSize=\"4.5\" opacity=\"0.7\" x=\"133\" y=\"30\">INPUT_B</text>\n                    <text fill=\"#ffb689\" fontFamily=\"monospace\" fontSize=\"4.5\" opacity=\"0.9\" x=\"106\" y=\"102\">PENDING_STATE</text>\n                  </svg>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Foreground Card: Clinical & Precise Control Queue */}\n          <div className=\"absolute -right-4 sm:-right-8 lg:-right-12 bottom-[6%] w-[310px] sm:w-[350px] bg-[#0d0e0f]/95 backdrop-blur-xl border border-white/[0.08] rounded-lg p-5 sm:p-6 shadow-[0_30px_60px_-12px_rgba(0,0,0,0.7)] z-20\">\n            <div className=\"flex items-center justify-between mb-5\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-1.5 h-1.5 bg-[#50d8e9] rounded-full shadow-[0_0_6px_rgba(80,216,233,0.8)]\"></div>\n                <span className=\"text-[10px] font-mono-data font-bold text-white tracking-[0.2em] uppercase\">\n                  Control Queue\n                </span>\n              </div>\n              <span className=\"text-[8px] font-mono-data text-[#9A9DA3]/50 uppercase\">\n                ID: 0x294_Q\n              </span>\n            </div>\n\n            <div className=\"space-y-4\">\n              {queueItems.map((item) => (\n                <div\n                  key={item.id}\n                  onClick={() => onOpenDecisionReview(item)}\n                  className=\"flex justify-between items-center group cursor-pointer p-2 rounded hover:bg-white/[0.02] transition-colors border border-transparent hover:border-white/[0.04]\"\n                >\n                  <div className=\"space-y-0.5 max-w-[190px]\">\n                    <div className=\"text-[11px] text-white/90 group-hover:text-white font-mono-data tracking-tight truncate\">\n                      {item.code}\n                    </div>\n                    <div className=\"text-[8px] font-mono-data text-[#9A9DA3]/50 uppercase tracking-tighter\">\n                      Priority: {item.priority} // 0{item.signalsCount}_SIGS\n                    </div>\n                  </div>\n\n                  {item.status === \'executed\' ? (\n                    <span className=\"px-2.5 py-1 text-[9px] font-mono-data text-[#50d8e9] border border-[#50d8e9]/30 rounded bg-[#50d8e9]/5 flex items-center gap-1\">\n                      <Check className=\"w-3 h-3\" /> OK\n                    </span>\n                  ) : item.code.includes(\'OKRS\') ? (\n                    <button\n                      onClick={(e) => handleExecute(item.id, e)}\n                      className=\"px-3 py-1 border border-[#5E6BFF]/40 text-[#bec2ff] text-[9px] font-mono-data hover:bg-[#5E6BFF]/15 transition-all uppercase tracking-widest rounded\"\n                    >\n                      Execute\n                    </button>\n                  ) : (\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onOpenDecisionReview(item);\n                      }}\n                      className=\"px-3 py-1 border border-white/10 text-[#e5e2e3]/60 text-[9px] font-mono-data hover:border-white/30 hover:text-white transition-all uppercase tracking-widest rounded\"\n                    >\n                      Review\n                    </button>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Copy */}\n        <div className=\"order-1 lg:order-2\">\n          <h2 className=\"font-h2 text-3xl sm:text-5xl lg:text-[48px] text-[#e5e2e3] mb-6 tracking-tight leading-tight\">\n            Guide every decision forward\n          </h2>\n          <p className=\"font-body-lg text-lg sm:text-[20px] text-[#9A9DA3] leading-relaxed max-w-xl\">\n            Map strategic decisions against operational timelines. Keep execution unblocked with clear ownership and context.\n          </p>\n\n          <div className=\"mt-8 space-y-3\">\n            <div className=\"flex items-center gap-3 text-sm text-[#e5e2e3]\">\n              <div className=\"w-1.5 h-1.5 rounded-full bg-[#5E6BFF]\"></div>\n              <span>Automated sign-off routing with cross-departmental dependency checking</span>\n            </div>\n            <div className=\"flex items-center gap-3 text-sm text-[#e5e2e3]\">\n              <div className=\"w-1.5 h-1.5 rounded-full bg-[#50d8e9]\"></div>\n              <span>Real-time sync to GitHub issues, Linear epics, and Jira boards</span>\n            </div>\n            <div className=\"flex items-center gap-3 text-sm text-[#e5e2e3]\">\n              <div className=\"w-1.5 h-1.5 rounded-full bg-[#ffb689]\"></div>\n              <span>Immutable audit trail for compliance, risk tracking, and post-mortems</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
