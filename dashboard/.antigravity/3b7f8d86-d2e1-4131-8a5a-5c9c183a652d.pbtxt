        instruction: "import React, { useState, useEffect } from \'react\';\nimport { \n  ArrowLeft, Activity, Bell, Check, Filter, Layers, \n  Play, Pause, Plus, RefreshCw, Search, ShieldCheck, \n  Terminal, Zap, ExternalLink, GitPullRequest, AlertCircle \n} from \'lucide-react\';\nimport { ControlQueueItem, SignalItem } from \'../types\';\n\ninterface LiveDashboardViewProps {\n  onBackToPlatform: () => void;\n  onOpenDecisionReview: (item: ControlQueueItem) => void;\n}\n\nexport function LiveDashboardView({\n  onBackToPlatform,\n  onOpenDecisionReview,\n}: LiveDashboardViewProps) {\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'signals\' | \'queue\' | \'integrations\'>(\'overview\');\n  const [isStreaming, setIsStreaming] = useState(true);\n  const [latency, setLatency] = useState(1.24);\n  const [throughput, setThroughput] = useState(124.9);\n  const [filterSeverity, setFilterSeverity] = useState<\'all\' | \'critical\' | \'warning\' | \'nominal\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // Initial Control Queue State\n  const [queue, setQueue] = useState<ControlQueueItem[]>([\n    {\n      id: \'q1\',\n      code: \'Q4_STRATEGIC_OKRS\',\n      title: \'Finalize Q4 Strategic Objectives & Resource Balancing\',\n      priority: \'High\',\n      signalsCount: 2,\n      status: \'pending\',\n      owner: \'Elena Rostova (VP Product)\',\n      impact: \'Aligns 6 product teams on multi-tenant isolation roadmap for enterprise SLA guarantees.\',\n      date: \'2026-09-18\',\n    },\n    {\n      id: \'q2\',\n      code: \'HIRING_V4_SCALE\',\n      title: \'Infrastructure & Platform Lead Headcount Authorization\',\n      priority: \'Med\',\n      signalsCount: 5,\n      status: \'pending\',\n      owner: \'David Kim (Director of Eng)\',\n      impact: \'Unblocks distributed caching and real-time Kafka partition scaling for Q1 volume surges.\',\n      date: \'2026-09-22\',\n    },\n    {\n      id: \'q3\',\n      code: \'INFRA_AUDIT_Q3\',\n      title: \'Quarterly Cloud Cost Allocation & Kubernetes Re-binning\',\n      priority: \'Low\',\n      signalsCount: 1,\n      status: \'pending\',\n      owner: \'Marcus Vance (FinOps)\',\n      impact: \'Recovers estimated $18.4k/mo in idle memory reservations across staging clusters.\',\n      date: \'2026-09-28\',\n    },\n    {\n      id: \'q4\',\n      code: \'REDIS_CLUSTER_FAILOVER_TEST\',\n      title: \'Disaster Recovery Automated Chaos Simulation in EU-West\',\n      priority: \'High\',\n      signalsCount: 4,\n      status: \'pending\',\n      owner: \'Sarah Jenkins (Site Reliability Lead)\',\n      impact: \'Validates automated multi-region replication failover without manual engineer on-call intervention.\',\n      date: \'2026-09-29\',\n    },\n  ]);\n\n  // Initial Signals State\n  const [signals, setSignals] = useState<SignalItem[]>([\n    {\n      id: \'sig-101\',\n      source: \'Datadog\',\n      systemHash: \'0x8F22A_BETA\',\n      timestamp: \'Just now\',\n      title: \'p99 API Latency normalized to 1.18ms in us-east-1\',\n      priority: \'Low\',\n      status: \'Nominal\',\n      value: \'1.18ms\',\n      metric: \'p99 latency\',\n    },\n    {\n      id: \'sig-102\',\n      source: \'Linear\',\n      systemHash: \'0x4A119_SYNC\',\n      timestamp: \'2m ago\',\n      title: \'PR-892: Zero-downtime database migration schema approved\',\n      priority: \'High\',\n      status: \'Nominal\',\n      value: \'Merged\',\n      metric: \'PR #892\',\n    },\n    {\n      id: \'sig-103\',\n      source: \'PagerDuty\',\n      systemHash: \'0x9E701_WARN\',\n      timestamp: \'6m ago\',\n      title: \'Transient memory variance in Redis Replica 04 (auto-recovered)\',\n      priority: \'Med\',\n      status: \'Warning\',\n      value: \'+12% mem\',\n      metric: \'Replica 04\',\n    },\n    {\n      id: \'sig-104\',\n      source: \'GitHub\',\n      systemHash: \'0x3C812_SEC\',\n      timestamp: \'14m ago\',\n      title: \'Automated dependency audit passed: 0 vulnerabilities found\',\n      priority: \'Low\',\n      status: \'Nominal\',\n      value: \'Clean\',\n      metric: \'Dependabot\',\n    },\n    {\n      id: \'sig-105\',\n      source: \'Jira\',\n      systemHash: \'0x5F192_OPS\',\n      timestamp: \'28m ago\',\n      title: \'Q4 Capacity Planning Milestone marked ready for Executive Review\',\n      priority: \'High\',\n      status: \'Nominal\',\n      value: \'Ready\',\n      metric: \'Sprint 44\',\n    },\n  ]);\n\n  // Live simulation tick\n  useEffect(() => {\n    if (!isStreaming) return;\n\n    const interval = setInterval(() => {\n      setLatency(prev => +(1.22 + Math.random() * 0.05).toFixed(2));\n      setThroughput(prev => +(124.7 + Math.random() * 0.4).toFixed(1));\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, [isStreaming]);\n\n  // Execute decision in queue\n  const handleExecute = (id: string) => {\n    setQueue(prev =>\n      prev.map(item =>\n        item.id === id ? { ...item, status: \'executed\' as const } : item\n      )\n    );\n  };\n\n  // Inject a simulated signal\n  const handleSimulateSignal = () => {\n    const newSig: SignalItem = {\n      id: `sig-${Date.now()}`,\n      source: \'Datadog\',\n      systemHash: `0x${Math.floor(Math.random() * 0xFFFFFF).toString(16).toUpperCase()}`,\n      timestamp: \'Just now\',\n      title: \'Simulated Inbound Event: Distributed Trace verification completed\',\n      priority: \'High\',\n      status: \'Nominal\',\n      value: \'Verified\',\n      metric: \'Telemetry Ingest\',\n    };\n    setSignals(prev => [newSig, ...prev]);\n  };\n\n  const filteredSignals = signals.filter(s => {\n    if (filterSeverity === \'critical\' && s.status !== \'Critical\') return false;\n    if (filterSeverity === \'warning\' && s.status !== \'Warning\') return false;\n    if (filterSeverity === \'nominal\' && s.status !== \'Nominal\') return false;\n    if (searchQuery && !s.title.toLowerCase().includes(searchQuery.toLowerCase()) && !s.source.toLowerCase().includes(searchQuery.toLowerCase())) {\n      return false;\n    }\n    return true;\n  });\n\n  return (\n    <div className=\"min-h-screen bg-[#070708] text-[#e5e2e3] pt-[80px]\">\n      {/* Live Workspace Sub-header */}\n      <div className=\"bg-[#0d0e0f] border-b border-[#232426] px-4 sm:px-8 py-3 sticky top-[80px] z-30\">\n        <div className=\"max-w-[1728px] mx-auto flex flex-wrap justify-between items-center gap-4\">\n          <div className=\"flex items-center gap-4\">\n            <button\n              onClick={onBackToPlatform}\n              className=\"text-xs font-mono-data text-[#9A9DA3] hover:text-white flex items-center gap-1.5 px-2.5 py-1.5 rounded border border-[#232426] hover:bg-[#101112] transition-colors\"\n            >\n              <ArrowLeft className=\"w-3.5 h-3.5\" />\n              <span>Back to Overview</span>\n            </button>\n\n            <div className=\"h-4 w-px bg-[#232426] hidden sm:block\"></div>\n\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs font-mono-data text-white font-medium\">Northline Command</span>\n              <span className=\"text-[10px] font-mono-data px-1.5 py-0.5 rounded bg-[#50d8e9]/10 text-[#50d8e9] border border-[#50d8e9]/30\">\n                US-EAST-01 // PRODUCTION\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-2 text-xs font-mono-data text-[#9A9DA3]\">\n              <span className=\"text-[#9A9DA3]/50\">LATENCY:</span>\n              <span className=\"text-white font-mono\">{latency}ms</span>\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#50d8e9] animate-pulse ml-1\"></span>\n            </div>\n\n            <button\n              onClick={() => setIsStreaming(!isStreaming)}\n              className=\"p-1.5 border border-[#232426] rounded text-[#9A9DA3] hover:text-white hover:bg-[#101112]\"\n              title={isStreaming ? \'Pause live streaming\' : \'Resume live stream\'}\n            >\n              {isStreaming ? <Pause className=\"w-3.5 h-3.5 text-[#50d8e9]\" /> : <Play className=\"w-3.5 h-3.5 text-[#bec2ff]\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Command Workspace */}\n      <div className=\"max-w-[1728px] mx-auto p-4 sm:p-8\">\n        {/* Navigation tabs within live layer */}\n        <div className=\"flex items-center justify-between border-b border-[#232426] pb-4 mb-8\">\n          <div className=\"flex gap-2 sm:gap-4 overflow-x-auto\">\n            {[\n              { id: \'overview\', label: \'Command Central\' },\n              { id: \'signals\', label: \'Signal Feed\' },\n              { id: \'queue\', label: \'Control Queue\' },\n              { id: \'integrations\', label: \'Connected Tools\' },\n            ].map(tab => (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id as any)}\n                className={`px-3 py-1.5 text-xs font-mono-data uppercase tracking-wider rounded transition-colors whitespace-nowrap ${\n                  activeTab === tab.id\n                    ? \'bg-[#1a1b1d] text-white border border-[#5E6BFF]/40 font-bold\'\n                    : \'text-[#9A9DA3] hover:text-white border border-transparent\'\n                }`}\n              >\n                {tab.label}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleSimulateSignal}\n              className=\"px-3 py-1.5 bg-[#101112] border border-[#232426] hover:border-[#50d8e9]/50 text-xs font-mono-data text-[#50d8e9] rounded flex items-center gap-1.5 transition-colors\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Simulate Signal</span>\n            </button>\n          </div>\n        </div>\n\n        {/* 1. OVERVIEW TAB */}\n        {activeTab === \'overview\' && (\n          <div className=\"space-y-8\">\n            {/* Top Stat Cards */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n              <div className=\"p-5 bg-[#101112] border border-[#232426] rounded-xl inner-glow\">\n                <span className=\"text-[9px] font-mono-data text-[#9A9DA3] uppercase tracking-wider block mb-1\">\n                  Cluster Throughput\n                </span>\n                <span className=\"text-2xl font-h3 font-bold text-white block\">\n                  {throughput} GB/S\n                </span>\n                <span className=\"text-[10px] font-mono-data text-[#50d8e9] mt-1 block\">\n                  Zero dropped packets\n                </span>\n              </div>\n\n              <div className=\"p-5 bg-[#101112] border border-[#232426] rounded-xl inner-glow\">\n                <span className=\"text-[9px] font-mono-data text-[#9A9DA3] uppercase tracking-wider block mb-1\">\n                  Active Control Queue\n                </span>\n                <span className=\"text-2xl font-h3 font-bold text-white block\">\n                  {queue.filter(q => q.status === \'pending\').length} Actions\n                </span>\n                <span className=\"text-[10px] font-mono-data text-[#ffb689] mt-1 block\">\n                  1 High Priority\n                </span>\n              </div>\n\n              <div className=\"p-5 bg-[#101112] border border-[#232426] rounded-xl inner-glow\">\n                <span className=\"text-[9px] font-mono-data text-[#9A9DA3] uppercase tracking-wider block mb-1\">\n                  Signal Ingestion\n                </span>\n                <span className=\"text-2xl font-h3 font-bold text-white block\">\n                  2,840 /min\n                </span>\n                <span className=\"text-[10px] font-mono-data text-[#bec2ff] mt-1 block\">\n                  Noise suppressed: 84%\n                </span>\n              </div>\n\n              <div className=\"p-5 bg-[#101112] border border-[#232426] rounded-xl inner-glow\">\n                <span className=\"text-[9px] font-mono-data text-[#9A9DA3] uppercase tracking-wider block mb-1\">\n                  Core Sync Latency\n                </span>\n                <span className=\"text-2xl font-h3 font-bold text-[#50d8e9] block font-mono\">\n                  {latency}ms\n                </span>\n                <span className=\"text-[10px] font-mono-data text-[#9A9DA3] mt-1 block\">\n                  Target &lt; 2.5ms\n                </span>\n              </div>\n\n              <div className=\"p-5 bg-[#101112] border border-[#232426] rounded-xl inner-glow\">\n                <span className=\"text-[9px] font-mono-data text-[#9A9DA3] uppercase tracking-wider block mb-1\">\n                  Global System Health\n                </span>\n                <span className=\"text-2xl font-h3 font-bold text-white block\">\n                  99.999%\n                </span>\n                <span className=\"text-[10px] font-mono-data text-[#50d8e9] mt-1 block\">\n                  OPERATIONAL // OK\n                </span>\n              </div>\n            </div>\n\n            {/* Split: Telemetry Stream vs Control Queue */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n              {/* Left: Waveform & Signals (7 cols) */}\n              <div className=\"lg:col-span-7 bg-[#101112] border border-[#232426] rounded-xl p-6 inner-glow\">\n                <div className=\"flex justify-between items-center mb-6\">\n                  <div>\n                    <h3 className=\"font-h3 text-lg font-bold text-white\">Live Analytical Feed</h3>\n                    <p className=\"text-xs text-[#9A9DA3] font-mono-data mt-0.5\">STREAM_HASH: 0x8F22A_BETA // REAL-TIME INGESTION</p>\n                  </div>\n                  <div className=\"flex items-center gap-2 text-xs font-mono-data text-[#50d8e9]\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#50d8e9] animate-pulse\"></span>\n                    <span>ACTIVE POLLING</span>\n                  </div>\n                </div>\n\n                <div className=\"h-64 border border-[#232426] rounded-lg bg-[#070708] relative overflow-hidden flex items-center justify-center p-4\">\n                  <div className=\"absolute inset-0 dot-pattern opacity-20 pointer-events-none\"></div>\n                  <svg className=\"w-full h-full\" preserveAspectRatio=\"none\" viewBox=\"0 0 1000 300\">\n                    <line opacity=\"0.1\" stroke=\"white\" strokeWidth=\"0.5\" x1=\"0\" x2=\"1000\" y1=\"150\" y2=\"150\" />\n                    <path \n                      d=\"M0,150 Q100,50 250,150 T500,150 T750,120 T1000,160\" \n                      fill=\"none\" \n                      stroke=\"#50d8e9\" \n                      strokeWidth=\"1.5\" \n                    />\n                    <path \n                      d=\"M0,170 Q150,220 350,130 T700,190 T1000,140\" \n                      fill=\"none\" \n                      stroke=\"#5E6BFF\" \n                      strokeWidth=\"1.2\" \n                      strokeDasharray=\"3 3\" \n                      opacity=\"0.6\" \n                    />\n                    <circle cx=\"500\" cy=\"150\" fill=\"#50d8e9\" r=\"4\" />\n                    <circle cx=\"750\" cy=\"120\" fill=\"#bec2ff\" r=\"3\" />\n                  </svg>\n                  <div className=\"absolute bottom-2 left-4 text-[9px] font-mono-data text-[#9A9DA3]/60\">\n                    VECTOR_SYNC: 100.00% // NO DELTA JITTER\n                  </div>\n                </div>\n\n                {/* Recent Signals list */}\n                <div className=\"mt-6 space-y-2.5\">\n                  <div className=\"text-xs font-mono-data text-[#9A9DA3] uppercase tracking-wider mb-2\">\n                    Latest Ingested Telemetry\n                  </div>\n                  {signals.slice(0, 3).map(sig => (\n                    <div key={sig.id} className=\"p-3 bg-[#0a0a0b] border border-[#232426] rounded flex justify-between items-center text-xs\">\n                      <div className=\"flex items-center gap-3\">\n                        <span className=\"px-2 py-0.5 rounded bg-[#1a1b1d] text-[#bec2ff] font-mono-data text-[10px]\">\n                          {sig.source}\n                        </span>\n                        <span className=\"text-[#e5e2e3] font-body-md truncate max-w-sm\">{sig.title}</span>\n                      </div>\n                      <span className=\"text-[10px] font-mono-data text-[#9A9DA3] shrink-0\">{sig.timestamp}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Right: Active Decisions Queue (5 cols) */}\n              <div className=\"lg:col-span-5 bg-[#101112] border border-[#232426] rounded-xl p-6 inner-glow flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex justify-between items-center mb-6\">\n                    <div>\n                      <h3 className=\"font-h3 text-lg font-bold text-white\">Leadership Control Queue</h3>\n                      <p className=\"text-xs text-[#9A9DA3] font-mono-data mt-0.5\">UNBLOCKED DECISION PIPELINE</p>\n                    </div>\n                    <span className=\"text-[10px] font-mono-data px-2 py-0.5 bg-[#5E6BFF]/10 text-[#bec2ff] border border-[#5E6BFF]/30 rounded\">\n                      ID: 0x294_Q\n                    </span>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    {queue.map(item => (\n                      <div\n                        key={item.id}\n                        className=\"p-4 bg-[#0a0a0b] border border-[#232426] rounded-lg hover:border-[#5E6BFF]/40 transition-colors\"\n                      >\n                        <div className=\"flex justify-between items-start mb-2\">\n                          <span className=\"text-[11px] font-mono-data text-white font-bold\">{item.code}</span>\n                          <span className={`text-[9px] font-mono-data px-2 py-0.5 rounded ${\n                            item.priority === \'High\' ? \'bg-[#ffb4ab]/10 text-[#ffb4ab] border border-[#ffb4ab]/30\' :\n                            \'bg-[#50d8e9]/10 text-[#50d8e9] border border-[#50d8e9]/30\'\n                          }`}>\n                            {item.priority}\n                          </span>\n                        </div>\n                        <p className=\"text-xs text-[#c6c5d8] mb-3 line-clamp-2\">\n                          {item.title}\n                        </p>\n                        <div className=\"flex justify-between items-center pt-2 border-t border-[#232426]/60\">\n                          <span className=\"text-[10px] font-mono-data text-[#9A9DA3]\">\n                            {item.signalsCount} correlated signals\n                          </span>\n                          {item.status === \'executed\' ? (\n                            <span className=\"text-xs font-mono-data text-[#50d8e9] flex items-center gap-1\">\n                              <Check className=\"w-3.5 h-3.5\" /> Executed\n                            </span>\n                          ) : (\n                            <div className=\"flex gap-2\">\n                              <button\n                                onClick={() => onOpenDecisionReview(item)}\n                                className=\"px-2.5 py-1 text-[10px] font-mono-data text-[#9A9DA3] hover:text-white border border-[#232426] rounded\"\n                              >\n                                Review\n                              </button>\n                              <button\n                                onClick={() => handleExecute(item.id)}\n                                className=\"px-3 py-1 text-[10px] font-mono-data bg-[#5E6BFF] text-white font-bold rounded hover:bg-[#4d5af5]\"\n                              >\n                                Execute\n                              </button>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"mt-4 pt-4 border-t border-[#232426] text-center\">\n                  <span className=\"text-[11px] font-mono-data text-[#9A9DA3]/60\">\n                    AUTOMATIC SYNC TO LINEAR & JIRA UPON EXECUTE\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* 2. SIGNALS TAB */}\n        {activeTab === \'signals\' && (\n          <div className=\"bg-[#101112] border border-[#232426] rounded-xl p-6 inner-glow space-y-6\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-[#232426]\">\n              <div>\n                <h3 className=\"font-h3 text-xl font-bold text-white\">Aggregated Signal Stream</h3>\n                <p className=\"text-xs text-[#9A9DA3] font-mono-data mt-0.5\">\n                  Correlated across 6 infrastructure tools and operational databases\n                </p>\n              </div>\n\n              {/* Filters */}\n              <div className=\"flex flex-wrap items-center gap-3\">\n                <div className=\"relative\">\n                  <Search className=\"w-3.5 h-3.5 absolute left-3 top-2.5 text-[#9A9DA3]\" />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Search signals...\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    className=\"bg-[#070708] border border-[#232426] rounded pl-8 pr-3 py-1.5 text-xs text-white placeholder-[#9A9DA3]/50 focus:outline-none focus:border-[#5E6BFF]\"\n                  />\n                </div>\n\n                <div className=\"flex gap-1 p-1 bg-[#070708] border border-[#232426] rounded\">\n                  {([\'all\', \'nominal\', \'warning\'] as const).map(f => (\n                    <button\n                      key={f}\n                      onClick={() => setFilterSeverity(f)}\n                      className={`px-2.5 py-1 text-[10px] font-mono-data rounded uppercase ${\n                        filterSeverity === f ? \'bg-[#1a1b1d] text-white font-bold\' : \'text-[#9A9DA3] hover:text-white\'\n                      }`}\n                    >\n                      {f}\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              {filteredSignals.map(sig => (\n                <div\n                  key={sig.id}\n                  className=\"p-4 bg-[#0a0a0b] border border-[#232426] rounded-lg flex flex-col sm:flex-row justify-between sm:items-center gap-3 hover:border-white/[0.1] transition-colors\"\n                >\n                  <div className=\"flex items-start sm:items-center gap-3\">\n                    <span className=\"px-2.5 py-1 rounded bg-[#101112] text-[#50d8e9] font-mono-data text-xs border border-[#232426]\">\n                      {sig.source}\n                    </span>\n                    <div>\n                      <div className=\"text-sm font-medium text-white\">{sig.title}</div>\n                      <div className=\"text-[10px] font-mono-data text-[#9A9DA3] mt-0.5\">\n                        HASH: {sig.systemHash} // METRIC: {sig.metric}\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-4 text-xs font-mono-data\">\n                    <span className={`px-2 py-0.5 rounded text-[10px] ${\n                      sig.status === \'Nominal\' ? \'text-[#50d8e9] bg-[#50d8e9]/10\' : \'text-[#ffb689] bg-[#ffb689]/10\'\n                    }`}>\n                      {sig.status}\n                    </span>\n                    <span className=\"text-[#9A9DA3]\">{sig.timestamp}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* 3. QUEUE TAB */}\n        {activeTab === \'queue\' && (\n          <div className=\"bg-[#101112] border border-[#232426] rounded-xl p-6 inner-glow space-y-6\">\n            <div className=\"flex justify-between items-center pb-4 border-b border-[#232426]\">\n              <div>\n                <h3 className=\"font-h3 text-xl font-bold text-white\">Full Decision Governance</h3>\n                <p className=\"text-xs text-[#9A9DA3] font-mono-data mt-0.5\">\n                  Traceable actions requiring leadership consensus or delegation\n                </p>\n              </div>\n              <span className=\"text-xs font-mono-data text-[#50d8e9]\">\n                {queue.filter(q => q.status === \'executed\').length} / {queue.length} Executed\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {queue.map(item => (\n                <div key={item.id} className=\"p-5 bg-[#0a0a0b] border border-[#232426] rounded-lg space-y-3\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-xs font-mono-data text-[#bec2ff] font-bold\">{item.code}</span>\n                    <span className=\"text-[10px] font-mono-data text-[#9A9DA3]\">{item.date}</span>\n                  </div>\n                  <h4 className=\"text-sm font-h3 font-bold text-white\">{item.title}</h4>\n                  <p className=\"text-xs text-[#9A9DA3] leading-relaxed\">{item.impact}</p>\n                  \n                  <div className=\"pt-3 border-t border-[#232426] flex justify-between items-center\">\n                    <span className=\"text-[10px] font-mono-data text-[#9A9DA3]\">\n                      Owner: {item.owner.split(\' \')[0]}\n                    </span>\n                    {item.status === \'executed\' ? (\n                      <span className=\"text-xs font-mono-data text-[#50d8e9] flex items-center gap-1\">\n                        <Check className=\"w-3.5 h-3.5\" /> Executed\n                      </span>\n                    ) : (\n                      <div className=\"flex gap-2\">\n                        <button\n                          onClick={() => onOpenDecisionReview(item)}\n                          className=\"px-3 py-1 text-xs font-mono-data border border-[#232426] text-white rounded hover:bg-[#101112]\"\n                        >\n                          Review\n                        </button>\n                        <button\n                          onClick={() => handleExecute(item.id)}\n                          className=\"px-4 py-1 text-xs font-mono-data bg-[#5E6BFF] text-white font-bold rounded hover:bg-[#4d5af5]\"\n                        >\n                          Execute\n                        </button>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* 4. INTEGRATIONS TAB */}\n        {activeTab === \'integrations\' && (\n          <div className=\"bg-[#101112] border border-[#232426] rounded-xl p-6 inner-glow space-y-6\">\n            <div className=\"pb-4 border-b border-[#232426]\">\n              <h3 className=\"font-h3 text-xl font-bold text-white\">Ingestion Connectors</h3>\n              <p className=\"text-xs text-[#9A9DA3] font-mono-data mt-0.5\">\n                Bi-directional synchronizers feeding the command layer\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              {[\n                { name: \'GitHub Enterprise\', status: \'Connected\', syncTime: \'1.2s ago\', icon: \'Git\', events: \'1,420 events/hr\' },\n                { name: \'Linear Workspace\', status: \'Connected\', syncTime: \'3.1s ago\', icon: \'Linear\', events: \'840 events/hr\' },\n                { name: \'Datadog APM\', status: \'Connected\', syncTime: \'0.4s ago\', icon: \'Datadog\', events: \'12,900 events/hr\' },\n                { name: \'PagerDuty\', status: \'Connected\', syncTime: \'14s ago\', icon: \'PagerDuty\', events: \'64 alerts/day\' },\n                { name: \'Jira Software Cloud\', status: \'Connected\', syncTime: \'5.2s ago\', icon: \'Jira\', events: \'320 updates/hr\' },\n                { name: \'Slack Ops Webhook\', status: \'Active\', syncTime: \'0.8s ago\', icon: \'Slack\', events: \'Direct broadcast\' },\n              ].map(c => (\n                <div key={c.name} className=\"p-5 bg-[#0a0a0b] border border-[#232426] rounded-lg space-y-3\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-sm font-bold text-white\">{c.name}</span>\n                    <span className=\"w-2 h-2 rounded-full bg-[#50d8e9]\"></span>\n                  </div>\n                  <div className=\"text-xs font-mono-data text-[#9A9DA3] space-y-1\">\n                    <div>STATUS: <span className=\"text-white\">{c.status}</span></div>\n                    <div>LAST_SYNC: <span className=\"text-[#50d8e9]\">{c.syncTime}</span></div>\n                    <div>VOLUME: {c.events}</div>\n                  </div>\n                  <button className=\"w-full py-1.5 border border-[#232426] hover:border-[#5E6BFF]/40 text-[11px] font-mono-data text-[#9A9DA3] hover:text-white rounded transition-colors\">\n                    Test Webhook Directive\n                  </button>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
