      create_file {
        instruction: "import React, { useState } from \'react\';\n\nexport function OperatingRhythmSection() {\n  // Fig 0.1 state\n  const [activeLayer, setActiveLayer] = useState<\'alpha\' | \'beta\' | \'all\'>(\'alpha\');\n  const [coords, setCoords] = useState(\'34.22 // 11.08\');\n\n  // Fig 0.2 state\n  const [activeNode, setActiveNode] = useState<string | null>(null);\n\n  // Fig 0.3 state\n  const [frequency, setFrequency] = useState<number>(440);\n  const [amplitude, setAmplitude] = useState<number>(1.0);\n\n  return (\n    <section className=\"px-4 sm:px-8 border-t border-[#232426] flex flex-col justify-center items-center relative overflow-hidden py-20 max-w-[1728px] mx-auto\">\n      <div className=\"max-w-[1516px] w-full mx-auto\">\n        <h2 className=\"font-h2 text-3xl sm:text-5xl text-center text-[#e5e2e3] mb-16 sm:mb-24 max-w-4xl mx-auto tracking-tight leading-tight\">\n          Operating rhythm, simplified. The architecture of a focused team.\n        </h2>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {/* Card 1: FIG 0.1 / UNIFIED VIEW */}\n          <div className=\"border border-[#232426] rounded-xl p-6 bg-[#070708] relative h-[420px] flex flex-col group hover:border-[#5E6BFF]/40 transition-colors\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <div className=\"font-mono-data text-[#9A9DA3] text-xs uppercase tracking-wider\">\n                FIG 0.1 / UNIFIED VIEW\n              </div>\n              <span className=\"text-[10px] font-mono-data text-[#5E6BFF]/80\">\n                ACTIVE_LAYER: {activeLayer.toUpperCase()}\n              </span>\n            </div>\n\n            <div \n              className=\"flex-1 border border-[#232426] rounded-lg bg-[#0a0a0b] flex items-center justify-center p-4 relative overflow-hidden\"\n              onMouseMove={(e) => {\n                const rect = e.currentTarget.getBoundingClientRect();\n                const x = ((e.clientX - rect.left) / rect.width * 100).toFixed(2);\n                const y = ((e.clientY - rect.top) / rect.height * 100).toFixed(2);\n                setCoords(`${x} // ${y}`);\n              }}\n            >\n              <div className=\"w-full h-full dot-pattern flex items-center justify-center relative\">\n                <svg fill=\"none\" height=\"85%\" viewBox=\"0 0 200 200\" width=\"85%\" xmlns=\"http://www.w3.org/2000/svg\">\n                  {/* Outer Frame */}\n                  <rect height=\"160\" rx=\"2\" stroke=\"#232426\" strokeWidth=\"0.5\" width=\"160\" x=\"20\" y=\"20\" />\n                  <line stroke=\"#232426\" strokeWidth=\"0.5\" x1=\"60\" x2=\"60\" y1=\"20\" y2=\"180\" />\n                  \n                  {/* SEC_ALPHA Box */}\n                  <g \n                    onClick={() => setActiveLayer(\'alpha\')} \n                    className=\"cursor-pointer\"\n                  >\n                    <rect \n                      height=\"40\" \n                      rx=\"1\" \n                      stroke={activeLayer === \'alpha\' ? \'#5E6BFF\' : \'#333538\'} \n                      strokeWidth={activeLayer === \'alpha\' ? \'1\' : \'0.5\'} \n                      fill={activeLayer === \'alpha\' ? \'rgba(94,107,255,0.08)\' : \'transparent\'}\n                      width=\"100\" \n                      x=\"70\" \n                      y=\"30\" \n                    />\n                    <text \n                      fill={activeLayer === \'alpha\' ? \'#bec2ff\' : \'#454655\'} \n                      fontFamily=\"monospace\" \n                      fontSize=\"6\" \n                      x=\"75\" \n                      y=\"45\"\n                      fontWeight=\"bold\"\n                    >\n                      SEC_ALPHA (STRATEGY)\n                    </text>\n                  </g>\n\n                  {/* SEC_BETA Box */}\n                  <g \n                    onClick={() => setActiveLayer(\'beta\')} \n                    className=\"cursor-pointer\"\n                  >\n                    <rect \n                      height=\"90\" \n                      rx=\"1\" \n                      stroke={activeLayer === \'beta\' ? \'#50d8e9\' : \'#232426\'} \n                      strokeWidth={activeLayer === \'beta\' ? \'1\' : \'0.5\'} \n                      fill={activeLayer === \'beta\' ? \'rgba(80,216,233,0.06)\' : \'transparent\'}\n                      width=\"100\" \n                      x=\"70\" \n                      y=\"80\" \n                    />\n                    <text \n                      fill={activeLayer === \'beta\' ? \'#50d8e9\' : \'#454655\'} \n                      fontFamily=\"monospace\" \n                      fontSize=\"6\" \n                      x=\"75\" \n                      y=\"95\"\n                      fontWeight=\"bold\"\n                    >\n                      SEC_BETA (EXECUTION)\n                    </text>\n                    <line stroke=\"#232426\" strokeWidth=\"0.5\" x1=\"75\" x2=\"165\" y1=\"110\" y2=\"110\" strokeDasharray=\"2 2\" />\n                    <line stroke=\"#232426\" strokeWidth=\"0.5\" x1=\"75\" x2=\"165\" y1=\"130\" y2=\"130\" strokeDasharray=\"2 2\" />\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"75\" y=\"122\">DATA_THREAD_01</text>\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"75\" y=\"142\">DATA_THREAD_02</text>\n                  </g>\n\n                  {/* Left Column Label */}\n                  <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"25\" y=\"30\">\n                    LAYER_0\n                  </text>\n                  <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"4.5\" x=\"25\" y=\"70\">\n                    SIGNALS\n                  </text>\n                  <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"4.5\" x=\"25\" y=\"110\">\n                    QUEUE\n                  </text>\n                </svg>\n\n                <div className=\"absolute bottom-2 right-2 font-mono-data text-[8px] text-[#9A9DA3] opacity-60\">\n                  COORD: {coords}\n                </div>\n              </div>\n            </div>\n            <div className=\"mt-3 flex justify-between text-[10px] font-mono-data text-[#9A9DA3]/70\">\n              <span>Interactive Layer Matrix</span>\n              <span className=\"text-[#bec2ff]\">Click to inspect SEC</span>\n            </div>\n          </div>\n\n          {/* Card 2: FIG 0.2 / DECISION GRAPH */}\n          <div className=\"border border-[#232426] rounded-xl p-6 bg-[#070708] relative h-[420px] flex flex-col group hover:border-[#50d8e9]/40 transition-colors\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <div className=\"font-mono-data text-[#9A9DA3] text-xs uppercase tracking-wider\">\n                FIG 0.2 / DECISION GRAPH\n              </div>\n              <span className=\"text-[10px] font-mono-data text-[#50d8e9]\">\n                {activeNode ? `NODE: ${activeNode}` : \'REL_MAP: SYNC\'}\n              </span>\n            </div>\n\n            <div className=\"flex-1 border border-[#232426] rounded-lg bg-[#0a0a0b] flex items-center justify-center p-4 relative overflow-hidden\">\n              <div className=\"w-full h-full dot-pattern flex items-center justify-center relative\">\n                <svg fill=\"none\" height=\"85%\" viewBox=\"0 0 200 200\" width=\"85%\" xmlns=\"http://www.w3.org/2000/svg\">\n                  {/* Central circle */}\n                  <circle cx=\"100\" cy=\"100\" r=\"40\" stroke=\"#50d8e9\" strokeWidth=\"0.75\" />\n                  <circle cx=\"100\" cy=\"100\" r=\"2\" fill=\"#50d8e9\" />\n\n                  {/* Corner nodes */}\n                  <g onMouseEnter={() => setActiveNode(\'ND_01 // OKR_FLOW\')} onMouseLeave={() => setActiveNode(null)} className=\"cursor-pointer\">\n                    <circle cx=\"40\" cy=\"40\" r=\"10\" stroke={activeNode?.includes(\'ND_01\') ? \'#50d8e9\' : \'#232426\'} strokeWidth=\"0.8\" fill={activeNode?.includes(\'ND_01\') ? \'rgba(80,216,233,0.1)\' : \'transparent\'} />\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"32\" y=\"32\">ND_01</text>\n                  </g>\n\n                  <g onMouseEnter={() => setActiveNode(\'ND_02 // INFRA_CAP\')} onMouseLeave={() => setActiveNode(null)} className=\"cursor-pointer\">\n                    <circle cx=\"160\" cy=\"40\" r=\"10\" stroke={activeNode?.includes(\'ND_02\') ? \'#50d8e9\' : \'#232426\'} strokeWidth=\"0.8\" fill={activeNode?.includes(\'ND_02\') ? \'rgba(80,216,233,0.1)\' : \'transparent\'} />\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"152\" y=\"32\">ND_02</text>\n                  </g>\n\n                  <g onMouseEnter={() => setActiveNode(\'ND_03 // RISK_CTRL\')} onMouseLeave={() => setActiveNode(null)} className=\"cursor-pointer\">\n                    <circle cx=\"160\" cy=\"160\" r=\"10\" stroke={activeNode?.includes(\'ND_03\') ? \'#50d8e9\' : \'#232426\'} strokeWidth=\"0.8\" fill={activeNode?.includes(\'ND_03\') ? \'rgba(80,216,233,0.1)\' : \'transparent\'} />\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"152\" y=\"178\">ND_03</text>\n                  </g>\n\n                  <g onMouseEnter={() => setActiveNode(\'ND_04 // TALENT\')} onMouseLeave={() => setActiveNode(null)} className=\"cursor-pointer\">\n                    <circle cx=\"40\" cy=\"160\" r=\"10\" stroke={activeNode?.includes(\'ND_04\') ? \'#50d8e9\' : \'#232426\'} strokeWidth=\"0.8\" fill={activeNode?.includes(\'ND_04\') ? \'rgba(80,216,233,0.1)\' : \'transparent\'} />\n                    <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"5\" x=\"32\" y=\"178\">ND_04</text>\n                  </g>\n\n                  {/* Dotted lines connecting to center circle */}\n                  <line stroke=\"#454655\" strokeDasharray=\"2 2\" strokeWidth=\"0.5\" x1=\"47\" x2=\"71\" y1=\"47\" y2=\"71\" />\n                  <line stroke=\"#454655\" strokeDasharray=\"2 2\" strokeWidth=\"0.5\" x1=\"153\" x2=\"129\" y1=\"47\" y2=\"71\" />\n                  <line stroke=\"#454655\" strokeDasharray=\"2 2\" strokeWidth=\"0.5\" x1=\"153\" x2=\"129\" y1=\"153\" y2=\"129\" />\n                  <line stroke=\"#454655\" strokeDasharray=\"2 2\" strokeWidth=\"0.5\" x1=\"47\" x2=\"71\" y1=\"153\" y2=\"129\" />\n\n                  {/* Tiny nodes at intersections */}\n                  <rect fill=\"#50d8e9\" height=\"3\" width=\"3\" x=\"70\" y=\"70\" />\n                  <rect fill=\"#50d8e9\" height=\"3\" width=\"3\" x=\"128\" y=\"70\" />\n                  <rect fill=\"#50d8e9\" height=\"3\" width=\"3\" x=\"128\" y=\"128\" />\n                  <rect fill=\"#50d8e9\" height=\"3\" width=\"3\" x=\"70\" y=\"128\" />\n\n                  <text fill=\"#c6c5d8\" fontFamily=\"monospace\" fontSize=\"6.5\" fontWeight=\"bold\" x=\"87\" y=\"102\">\n                    ROOT_V1\n                  </text>\n                </svg>\n\n                <div className=\"absolute top-2 left-2 font-mono-data text-[8px] text-[#9A9DA3] opacity-60\">\n                  REL_MAP: SYNC\n                </div>\n              </div>\n            </div>\n            <div className=\"mt-3 flex justify-between text-[10px] font-mono-data text-[#9A9DA3]/70\">\n              <span>Bi-directional Lineage</span>\n              <span className=\"text-[#50d8e9]\">Hover nodes to trace</span>\n            </div>\n          </div>\n\n          {/* Card 3: FIG 0.3 / AUTOMATED RHYTHM */}\n          <div className=\"border border-[#232426] rounded-xl p-6 bg-[#070708] relative h-[420px] flex flex-col group hover:border-[#E5FD17]/40 transition-colors\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <div className=\"font-mono-data text-[#9A9DA3] text-xs uppercase tracking-wider\">\n                FIG 0.3 / AUTOMATED RHYTHM\n              </div>\n              <div className=\"flex gap-2\">\n                {[220, 440, 880].map((f) => (\n                  <button\n                    key={f}\n                    onClick={() => setFrequency(f)}\n                    className={`text-[9px] font-mono-data px-1.5 py-0.5 rounded transition-colors ${\n                      frequency === f ? \'bg-[#E5FD17] text-black font-bold\' : \'text-[#9A9DA3] hover:text-white\'\n                    }`}\n                  >\n                    {f}Hz\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"flex-1 border border-[#232426] rounded-lg bg-[#0a0a0b] flex items-center justify-center p-4 relative overflow-hidden\">\n              <div className=\"w-full h-full dot-pattern flex items-center justify-center relative\">\n                <svg fill=\"none\" height=\"85%\" viewBox=\"0 0 200 200\" width=\"85%\" xmlns=\"http://www.w3.org/2000/svg\">\n                  {/* Sine wave with dynamic wave variation based on frequency */}\n                  {frequency === 440 && (\n                    <path d=\"M20,100 Q60,20 100,100 T180,100\" fill=\"none\" stroke=\"#E5FD17\" strokeWidth=\"1\" />\n                  )}\n                  {frequency === 220 && (\n                    <path d=\"M20,100 Q100,20 180,100\" fill=\"none\" stroke=\"#E5FD17\" strokeWidth=\"1\" />\n                  )}\n                  {frequency === 880 && (\n                    <path d=\"M20,100 Q40,40 60,100 T100,100 T140,100 T180,100\" fill=\"none\" stroke=\"#E5FD17\" strokeWidth=\"1\" />\n                  )}\n\n                  {/* Vertical dashed line at focal point */}\n                  <line stroke=\"#454655\" strokeDasharray=\"2 2\" strokeWidth=\"0.5\" x1=\"100\" x2=\"100\" y1=\"20\" y2=\"180\" />\n                  <circle cx=\"100\" cy=\"100\" fill=\"#E5FD17\" r=\"3.5\" />\n                  <circle cx=\"100\" cy=\"100\" fill=\"none\" stroke=\"#E5FD17\" strokeWidth=\"0.5\" r=\"8\" opacity=\"0.5\" />\n\n                  {/* Axis indicators */}\n                  <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"8\" x=\"185\" y=\"105\">t</text>\n                  <text fill=\"#454655\" fontFamily=\"monospace\" fontSize=\"8\" x=\"105\" y=\"25\">v</text>\n\n                  {/* Technical Callout */}\n                  <text fill=\"#E5FD17\" fontFamily=\"monospace\" fontSize=\"6.5\" fontWeight=\"bold\" x=\"108\" y=\"96\">\n                    [100, 100]\n                  </text>\n                  <text fill=\"#9A9DA3\" fontFamily=\"monospace\" fontSize=\"5\" x=\"108\" y=\"106\">\n                    SYNC_EVENT\n                  </text>\n                </svg>\n\n                <div className=\"absolute bottom-2 right-2 font-mono-data text-[8px] text-[#9A9DA3] opacity-60\">\n                  FREQ: {frequency}HZ // AMPL: {amplitude.toFixed(1)}\n                </div>\n              </div>\n            </div>\n            <div className=\"mt-3 flex justify-between text-[10px] font-mono-data text-[#9A9DA3]/70\">\n              <span>Predictable Cadence Pulse</span>\n              <span className=\"text-[#E5FD17]\">Zero jitter heartbeat</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
