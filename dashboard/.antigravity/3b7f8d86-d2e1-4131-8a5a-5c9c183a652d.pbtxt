      thinking_signature: "\022\223\f\n\220\f\001i\024}\023.5\374\331;\032\365\235\346\243g\370\342(\275W\205\f\036<7\324YW\216\342\317\3125\234\326\242\226\257\r\256g\264\313>\004$\225\275\257\344\343\3633\r\355}%q\212\337\016eB\301W\350\307\275\177m\a\261\266\2747-\3745} \347t\211\034E\343\265\342J\321:\f\337E\274\210\351i[\361\253^=\200\225C\006\355\335\312\331\253\364\346\234\036\226\351\177\004\362@\273\236\245}\311\247\352m\302\033\241\2777\tR.\313\377\376\361l\270\214Y\353\ag@u\231/\230y\351p\350(\221\245\334\236\225m/\203\326D\220\026\320\320\213\335h\374IK3\355F,\301\313\214_\201\311A\215\025\252\350k\305\310\332,y\207g\374\230\204\201\034\220\317H-z\030t\341C\"\002\311\033|\020\303+q\240\252m{1\276\230H\333<M-\276%\253C\000f\307q\216\343\021\257pU}gP\367A\332@ \247\371R\b\255\337\364SS\263(\353\223\232\267\326\020\3155\374\352\204\340\037^\020\b\352a\265h\255\003\324n\\C \254{<a`I=v\231\251\257\256\232{a\324\002\003\312\272H.EN \227\332(&\237\347HGN\250a\237\212\222\031\277\360Y\267\034\201\017s\342\244\371&\365:\"\246\200\355\240\312\345\205*\366\0342i\373\341^`\315\371QZ`;\342\245\260\357\255\021\v\001]+h\235\233H\3310\034\316)\024\372\234F\312.\334\251b,VW \246\355\225\017L\272\365\035\b\274\315\350l\'fruJ-\304\365\273-S\251\373\026\361\206\376<\263jo=\016\020\375?\024l\371\226y\227$-{\370\3576\324!\030U\210\177\304L\346\324\n\277Ae\307\3701[\030\032\036\221h\235\342\b\371\326\336:$s}8W\203SF\373\033\246\255\3206\000\216\342\215d\203a\222k\254\223\243\375;\203\006\323\026\367\262\231\254\a\227!\241\253\017\343[\302Dc\331\200n\265&h\030\200vT\334\200\337\023\330y&\360\336?]Q\251=+\001\241\234\203B\275\322\\\1774A\3402Da\335#\225\030Q3\024~S\274-\242\365\200{\211\362.\303\347\n\334i\247&|D\266h6\372h\214\237v\273r\301\324&\210\3475xsk\034\nv\310R\f\215\214^\337w\230\327\t\221\300\341>\305f\305X\032\204\316\275-\300\311\354\306\034\212\307\277\n\217\242f\211\317\264\316\346\017B\331\243P\000\213\351L|\v\334\223\373\224\230e\341=\275\024\366\262y\376\310t\224\234\215\316\3436\256G9\320\177\253\332\302\341i;U\363\320\267\253\354\362=@\242\334\002\262(\317\264\a}l\330\001\317\377\bPj:\006\263\234\224\362-\336\243\371k,Q\335\376\223\217\222\260\031\264\212\246\n\224\215\251G\334\365\274\332Rfb\374\235\2622s@(\315@h8\337\r2\305\376\325\313]dzZ\303\355\214B\262t\n\364O\f\002|a\212*\250\3110\265\376\034.\216\\\3358\306=\271\207#\022<\323\326\371\316+\235\363F\207:FB\366\355\211\340\247\315\344\362\235\254I\236\365\020q\356)M\212V\320\326\230\372\220\256\\\210\225\301\224?\263J\334\300\302*\257S:\250\206Q/\237\004A\377\005\003\301\314\231?\362\240\206\037\305HT#\242\333\356\t\020\272s\346g\331B\362\277lb\340\330\310\217~t\256T0V`\217\v\244x\334=p\031\341\036a.\276\347\272\264\370\"u\035U\333! \343\177\333\0361rL\313\223\251\272\017\026|\236\257\211\207\312t\020F\337\023\313\302\376\240\022n5n\347\024\023n\334\f\322\213\201\320\024&\367i\354\300gl\037\315u\223\356Y\266||\212R\341cUV\357X\241\033\256.\\67I\260\252c\371\2235\016\234f\231\301\264\006\3749\020\253\'\203U\304q\341k6 \343\004(\033h\352\333\030\366\300\177\306\n\222\322\177\346\240\354z?,\203\325-\263N\241\271\026\357\033\244A\210\220\301>\311\244O3\\\252\351\233|M\334\322I\345\205\027\211d@U?y\r\032\331\227\366\225u\037\372\230`O\003t4\205\375\260\222\214T\005U\357\317\f\"\227\327\022v\256v\277E\363\346\263\346J V\350s\233\000-d\266p\213\313\277\016\324\341\230\262\034\374\266\212%jw\235\304<\364?\245m\f=e\227rf\353\222\246\346.\307\366\314\r\324 0\340\\\371\324\005U\327\321\236m\340A\304W#\016\233\215\351\035\360\333m\353q\304y\331\220\327\222\305\223.\314\275\355\240\2743nn\037\'\377e4\213JK\243\345\262\376\0178\372\321\252a|\313\321\261\204+\335\245\240LK\037\fg\f\236\362\266\003\025\367c\022\331%\326\f|.g\377C\266!\210\265\376\033\357\035j!d(t\245\275 \350\346\212u\303\006Y\255t\005c\005\314\024\320\324\271\230n\3129\366\327\023\211Bi\352\3139\243\2004\227\271G\251#\214\320\322z\266\200s./\267\022\342\027\243\027\377/\3655\246\306\220I\342\\\3065\362R\240\321Cw